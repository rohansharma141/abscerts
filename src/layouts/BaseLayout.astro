---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
}

const { title, description, canonical, ogImage } = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(ogImage ?? '/og-image.jpg', Astro.site).href;
const path = Astro.url.pathname;

// Organization + WebSite JSON-LD — emitted on every page (extracted from v7 head).
// Service + FAQPage nodes from v7 are emitted per-page (home / contact) via the "head" slot.
const orgSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://www.abscerts.com/#organization',
      name: 'ABS Certifications & Advisory',
      alternateName: 'ABS Certifications',
      url: 'https://www.abscerts.com/',
      logo: {
        '@type': 'ImageObject',
        url: 'https://www.abscerts.com/logo.png',
        width: 512,
        height: 512,
      },
      description:
        'Independent certification body issuing IAS/IAF-accredited ISO certifications and SOC 2 reports for organisations across UK, EU, US and Middle East.',
      foundingDate: '2008',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Building No. 1, C/O Sriram, Near Railway Phatak, Mangli Purwa',
        addressLocality: 'Hardoi',
        addressRegion: 'Uttar Pradesh',
        postalCode: '241001',
        addressCountry: 'IN',
      },
      contactPoint: [
        {
          '@type': 'ContactPoint',
          telephone: '+91-96257-76771',
          contactType: 'sales',
          areaServed: ['GB', 'US', 'AE', 'DE', 'FR', 'SA', 'QA', 'OM'],
          availableLanguage: ['English', 'Arabic', 'German', 'French'],
        },
        {
          '@type': 'ContactPoint',
          telephone: '+91-97925-86202',
          contactType: 'customer support',
          areaServed: ['GB', 'US', 'AE', 'DE', 'FR', 'SA', 'QA', 'OM'],
          availableLanguage: ['English'],
        },
      ],
      sameAs: [
        'https://www.linkedin.com/company/abs-certifications',
        'https://twitter.com/abscerts',
        'https://www.youtube.com/@abscerts',
      ],
      areaServed: [
        { '@type': 'Country', name: 'United Kingdom' },
        { '@type': 'Country', name: 'United States' },
        { '@type': 'Country', name: 'United Arab Emirates' },
        { '@type': 'Country', name: 'Germany' },
        { '@type': 'Country', name: 'Saudi Arabia' },
        { '@type': 'Country', name: 'France' },
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://www.abscerts.com/#website',
      url: 'https://www.abscerts.com/',
      name: 'ABS Certifications & Advisory',
      publisher: { '@id': 'https://www.abscerts.com/#organization' },
      inLanguage: 'en-GB',
      potentialAction: {
        '@type': 'SearchAction',
        target: 'https://www.abscerts.com/search?q={search_term_string}',
        'query-input': 'required name=search_term_string',
      },
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="IE=edge">

<!-- ============ Primary SEO ============ -->
<title>{title}</title>
<meta name="description" content={description}>
<meta name="keywords" content="ISO certification, ISO 9001, ISO 27001, ISO 14001, ISO 45001, SOC 2, PCI DSS, CMMI, certification body, IAS accredited, IAF MLA, audit services, UK, Europe, Middle East, USA">
<meta name="author" content="ABS Certifications & Advisory">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
<meta name="googlebot" content="index, follow">
<link rel="canonical" href={canonicalURL}>

<!-- ============ Open Graph (Facebook, LinkedIn) ============ -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="ABS Certifications & Advisory">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonicalURL}>
<meta property="og:image" content={ogImageURL}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="ABS Certifications & Advisory — accredited certification body">
<meta property="og:locale" content="en_GB">
<meta property="og:locale:alternate" content="en_US">

<!-- ============ Twitter Card ============ -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImageURL}>
<meta name="twitter:image:alt" content="ABS Certifications & Advisory">

<!-- ============ Theme & PWA ============ -->
<meta name="theme-color" content="#081F4D">
<meta name="msapplication-TileColor" content="#081F4D">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

<!-- ============ Favicon (placeholder paths — replace with real assets in production) ============ -->
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='12' fill='%23081F4D'/%3E%3Ctext x='50' y='68' font-family='Georgia,serif' font-size='56' font-weight='500' text-anchor='middle' fill='%23fff'%3EA%3C/text%3E%3Crect x='78' y='78' width='14' height='14' rx='2' fill='%2334E0C4'/%3E%3C/svg%3E">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">

<!-- ============ Performance: preconnect to all third-party origins ============ -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://images.unsplash.com">
<link rel="preconnect" href="https://cdn.jsdelivr.net">
<link rel="dns-prefetch" href="https://wa.me">

<!-- ============ Fonts (with font-display=swap to avoid invisible text) ============ -->
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.47.0/tabler-icons.min.css" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.47.0/tabler-icons.min.css"></noscript>

<!-- ============ Schema.org structured data: Organization + WebSite ============ -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(orgSchema)} />

<!-- Per-page <head> additions (hero preload, page-specific JSON-LD) -->
<slot name="head" />
</head>
<body>

<!-- Skip-to-content link for accessibility/keyboard users -->
<a href="#main-content" class="skip-link">Skip to content</a>

<!-- ============ TOP BAR ============ -->
<div class="topbar">
  <div class="container">
    <div class="topbar-left">
      <span class="topbar-hide-mobile"><span class="live-dot"></span>Office hours · 09:00–18:00 IST</span>
      <a href="mailto:info@abscerts.com"><i class="ti ti-mail"></i>info@abscerts.com</a>
    </div>
    <div class="topbar-right">
      <a href="tel:+919625776771"><i class="ti ti-phone"></i>+91 96257 76771</a>
      <a href="tel:+919792586202" class="topbar-hide-mobile"><i class="ti ti-phone"></i>+91 97925 86202</a>
      <span class="topbar-hide-mobile"><i class="ti ti-world"></i>EN · 40+ countries</span>
    </div>
  </div>
</div>

<!-- ============ HEADER ============ -->
<header class="header" role="banner">
  <div class="container">
    <a href="/" class="logo">
      <div class="logo-mark">A</div>
      <div class="logo-text">
        <p>ABS Certifications</p>
        <p>Independent · Accredited · Global</p>
      </div>
    </a>
    <nav class="nav" aria-label="Primary navigation">
      <a href="/" id="nav-home" class:list={[{ active: path === '/' }]}>Home</a>
      <a href="/#services">Services</a>
      <a href="/#industries">Industries</a>
      <a href="/#process">Process</a>
      <a href="/verify">Verify</a>
      <a href="/contact" id="nav-contact" class:list={[{ active: path === '/contact' }]}>Contact</a>
      <button class="btn btn-primary" onclick="openQuoteModal()">Request quote <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></button>
    </nav>
    <button class="hamburger" onclick="toggleMobileNav()" aria-label="Open menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<main id="main-content">
  <slot />
</main>

<!-- ============ FOOTER ============ -->
<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="logo">
          <div class="logo-mark">A</div>
          <div class="logo-text">
            <p>ABS Certifications</p>
            <p>Independent · Accredited · Global</p>
          </div>
        </div>
        <p class="footer-tag">Independent certification body serving organisations across UK, EU, US, Middle East and APAC. Accredited audits, transparent pricing, global delivery.</p>
        <div class="footer-newsletter">
          <label>Stay in the loop</label>
          <div class="footer-newsletter-input">
            <input type="email" placeholder="your@email.com">
            <button><i class="ti ti-arrow-right"></i></button>
          </div>
        </div>
      </div>
      <div>
        <h4>Services</h4>
        <ul class="footer-links">
          <li><a href="#">ISO certifications</a></li>
          <li><a href="#">SOC 2 & cyber security</a></li>
          <li><a href="#">CMMI appraisals</a></li>
          <li><a href="#">Training & advisory</a></li>
          <li><a href="#">Third-party inspection</a></li>
        </ul>
      </div>
      <div>
        <h4>Company</h4>
        <ul class="footer-links">
          <li><a href="#">About us</a></li>
          <li><a href="#">Accreditation</a></li>
          <li><a href="/verify">Verify certificate</a></li>
          <li><a href="#">Careers</a></li>
          <li><a href="#">Blog & insights</a></li>
        </ul>
      </div>
      <div>
        <h4>Contact</h4>
        <div class="footer-contact-item"><i class="ti ti-phone"></i><span>+91 96257 76771<br>+91 97925 86202</span></div>
        <div class="footer-contact-item"><i class="ti ti-mail"></i><span>info@abscerts.com</span></div>
        <div class="footer-contact-item"><i class="ti ti-map-pin"></i><span>Hardoi, Uttar Pradesh, India</span></div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 ABS Certifications & Advisory. All rights reserved.</span>
      <div class="footer-social">
        <a href="#" aria-label="LinkedIn"><i class="ti ti-brand-linkedin"></i></a>
        <a href="#" aria-label="X"><i class="ti ti-brand-x"></i></a>
        <a href="#" aria-label="YouTube"><i class="ti ti-brand-youtube"></i></a>
      </div>
      <span>Privacy · Terms · ISMS policy</span>
    </div>
  </div>
</footer>

<!-- ============ MOBILE NAV ============ -->
<div class="mobile-nav-backdrop" id="mobileNavBackdrop" onclick="toggleMobileNav()"></div>
<aside class="mobile-nav" id="mobileNav" aria-hidden="true">
  <button class="mobile-nav-close" onclick="toggleMobileNav()" aria-label="Close menu"><i class="ti ti-x"></i></button>
  <a href="/" onclick="toggleMobileNav()">Home</a>
  <a href="/#services" onclick="toggleMobileNav()">Services</a>
  <a href="/#industries" onclick="toggleMobileNav()">Industries</a>
  <a href="/#process" onclick="toggleMobileNav()">Process</a>
  <a href="/verify" onclick="toggleMobileNav()">Verify</a>
  <a href="/contact" onclick="toggleMobileNav()">Contact</a>
  <div class="mobile-nav-cta">
    <button class="btn btn-primary" onclick="openQuoteModal(); toggleMobileNav();">Request a quote <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></button>
    <a class="btn btn-outline" href="/contact" onclick="toggleMobileNav()"><i class="ti ti-calendar-event"></i>Book a meeting</a>
  </div>
  <div class="mobile-nav-contact">
    <a href="tel:+919625776771" class="mobile-nav-contact-item"><i class="ti ti-phone"></i>+91 96257 76771</a>
    <a href="tel:+919792586202" class="mobile-nav-contact-item"><i class="ti ti-phone"></i>+91 97925 86202</a>
    <a href="mailto:info@abscerts.com" class="mobile-nav-contact-item"><i class="ti ti-mail"></i>info@abscerts.com</a>
  </div>
</aside>

<!-- ============ FLOATING WIDGETS ============ -->
<div class="float-stack">
  <button class="float-btn scroll-top" id="scrollTopBtn" onclick="scrollToTop()" aria-label="Scroll to top">
    <i class="ti ti-arrow-up"></i>
    <span class="tooltip">Back to top</span>
  </button>
  <button class="float-btn whatsapp" onclick="openWhatsApp()" aria-label="WhatsApp us">
    <i class="ti ti-brand-whatsapp"></i>
    <span class="tooltip">Chat on WhatsApp</span>
  </button>
  <button class="float-btn call" onclick="toggleCallMenu(event)" aria-label="Call us">
    <i class="ti ti-phone"></i>
    <span class="tooltip">Call us</span>
    <div class="call-menu" id="callMenu" onclick="event.stopPropagation()">
      <div class="call-menu-head">Choose a line to call</div>
      <a href="tel:+919625776771">
        <i class="ti ti-phone-call"></i>
        <span>
          <strong>+91 96257 76771</strong>
          <small>Sales · new enquiries</small>
        </span>
      </a>
      <a href="tel:+919792586202">
        <i class="ti ti-phone-call"></i>
        <span>
          <strong>+91 97925 86202</strong>
          <small>Audits · existing clients</small>
        </span>
      </a>
    </div>
  </button>
</div>

<!-- ============ QUOTE MODAL ============ -->
<div class="modal-backdrop" id="quoteModal" onclick="if(event.target===this) closeQuoteModal()">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="quoteModalTitle">
    <div class="modal-header">
      <button class="modal-close" onclick="closeQuoteModal()" aria-label="Close"><i class="ti ti-x"></i></button>
      <p class="eyebrow">Free · No obligation</p>
      <h2 id="quoteModalTitle">Request a quote</h2>
      <p>Tell us your scope. We'll send a fixed-price proposal within 24 hours.</p>
    </div>
    <div class="modal-body">
      <form data-form="quote">
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp-field">
        <div class="form-row">
          <div>
            <label>Full name *</label>
            <input type="text" name="name" class="form-control" placeholder="Jane Smith" required>
          </div>
          <div>
            <label>Work email *</label>
            <input type="email" name="email" class="form-control" placeholder="jane@company.com" required>
          </div>
        </div>
        <div class="form-row">
          <div>
            <label>Company *</label>
            <input type="text" name="company" class="form-control" placeholder="Acme Ltd" required>
          </div>
          <div>
            <label>Country *</label>
            <select name="country" class="form-control" required>
              <option value="">Select country</option>
              <option>United Kingdom</option>
              <option>United States</option>
              <option>United Arab Emirates</option>
              <option>Germany</option>
              <option>Saudi Arabia</option>
              <option>Other</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label>Service of interest *</label>
          <select name="service" class="form-control" required>
            <option value="">Select a service</option>
            <option>ISO 9001 — Quality</option>
            <option>ISO 27001 — Information Security</option>
            <option>ISO 14001 — Environmental</option>
            <option>SOC 2 Type I / II</option>
            <option>PCI DSS</option>
            <option>CMMI appraisal</option>
            <option>Other / not sure</option>
          </select>
        </div>
        <button type="submit" class="form-submit" data-submit>Send request <i class="ti ti-arrow-right"></i></button>
        <div data-form-status></div>
        <div class="modal-trust">
          <span><i class="ti ti-clock"></i>24-hour response</span>
          <span><i class="ti ti-shield-check"></i>Confidential</span>
          <span><i class="ti ti-currency-pound"></i>Multi-currency</span>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- ============ EXIT-INTENT POPUP ============ -->
<div class="exit-popup" id="exitPopup" onclick="if(event.target===this) closeExitPopup()">
  <div class="exit-popup-card">
    <div class="exit-popup-banner">
      <button class="exit-popup-close" onclick="closeExitPopup()" aria-label="Close"><i class="ti ti-x"></i></button>
      <div class="exit-popup-icon"><i class="ti ti-gift"></i></div>
      <h3>Before you go — let us <em>help</em></h3>
      <p>Drop your details and we'll send a free certification roadmap tailored to your business. No spam, ever.</p>
    </div>
    <div class="exit-popup-body">
      <div class="exit-popup-tabs">
        <button class="exit-popup-tab active" onclick="switchExitTab(this, 'email')">Email me</button>
        <button class="exit-popup-tab" onclick="switchExitTab(this, 'phone')">Call me back</button>
      </div>
      <form id="exitFormEmail" data-form="newsletter">
        <input type="hidden" name="type" value="email">
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp-field">
        <div class="exit-popup-input-row">
          <input type="email" name="email" class="exit-popup-input" placeholder="your@email.com" required>
          <button type="submit" class="exit-popup-submit" data-submit>Send <i class="ti ti-arrow-right"></i></button>
        </div>
        <div data-form-status></div>
      </form>
      <form id="exitFormPhone" style="display:none" data-form="newsletter">
        <input type="hidden" name="type" value="phone">
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp-field">
        <div class="exit-popup-input-row">
          <input type="tel" name="phone" class="exit-popup-input" placeholder="+44 20 7946 0958" required>
          <button type="submit" class="exit-popup-submit" data-submit>Call me <i class="ti ti-arrow-right"></i></button>
        </div>
        <div data-form-status></div>
      </form>
      <p class="exit-popup-disclaimer">By submitting, you agree to ABS's privacy policy. We never share your details.</p>
    </div>
  </div>
</div>

<script src="/scripts/global.js" is:inline></script>
</body>
</html>
