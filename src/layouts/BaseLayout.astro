---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import MegaMenu from '../components/layout/MegaMenu.astro';
import MobileServicesNav from '../components/layout/MobileServicesNav.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  // Keep the page out of search results (robots noindex). Used by /case-studies until the
  // first real case study is published (content review, B1-23).
  noindex?: boolean;
}

const { title, description, canonical, ogImage, noindex = false } = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(ogImage ?? '/og-image.jpg', Astro.site).href;
const path = Astro.url.pathname;
const year = new Date().getFullYear();

// Footer "Services" column — every category, in the same order as the mega-menu.
const footerCategories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);

// Organization + WebSite JSON-LD — emitted on every page (extracted from v7 head).
// Service + FAQPage nodes from v7 are emitted per-page (home / contact) via the "head" slot.
const orgSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://www.abscerts.com/#organization',
      name: 'ABS Certifications & Advisory',
      alternateName: 'ABS Certifications',
      url: 'https://www.abscerts.com/',
      logo: {
        '@type': 'ImageObject',
        url: 'https://www.abscerts.com/logo.png',
        width: 278,
        height: 45,
      },
      description:
        'Consulting and advisory firm helping organisations across UK, EU, US and Middle East achieve ISO, SOC 2 and CMMI certification.',
      foundingDate: '2004',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '178, Anaya House, Connaught Place',
        addressLocality: 'New Delhi',
        addressRegion: 'Delhi',
        postalCode: '110001',
        addressCountry: 'IN',
      },
      contactPoint: [
        {
          '@type': 'ContactPoint',
          telephone: '+91-98216-96444',
          contactType: 'customer service',
          areaServed: ['GB', 'US', 'AE', 'DE', 'FR', 'SA', 'QA', 'OM'],
          availableLanguage: ['English'],
        },
      ],
      sameAs: [
        'https://www.linkedin.com/company/abs-certifications',
        'https://twitter.com/abscerts',
        'https://www.youtube.com/@abscerts',
      ],
      areaServed: [
        { '@type': 'Country', name: 'United Kingdom' },
        { '@type': 'Country', name: 'United States' },
        { '@type': 'Country', name: 'United Arab Emirates' },
        { '@type': 'Country', name: 'Germany' },
        { '@type': 'Country', name: 'Saudi Arabia' },
        { '@type': 'Country', name: 'France' },
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://www.abscerts.com/#website',
      url: 'https://www.abscerts.com/',
      name: 'ABS Certifications & Advisory',
      publisher: { '@id': 'https://www.abscerts.com/#organization' },
      inLanguage: 'en-GB',
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="IE=edge">

<!-- ============ Primary SEO ============ -->
<title>{title}</title>
<meta name="description" content={description}>
<meta name="keywords" content="ISO certification, ISO 9001, ISO 27001, ISO 14001, ISO 45001, SOC 2, PCI DSS, CMMI, ISO consultant, certification consulting, audit readiness, UK, Europe, Middle East, USA">
<meta name="author" content="ABS Certifications & Advisory">
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}>
<meta name="googlebot" content={noindex ? 'noindex, follow' : 'index, follow'}>
<link rel="canonical" href={canonicalURL}>

<!-- ============ Open Graph (Facebook, LinkedIn) ============ -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="ABS Certifications & Advisory">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonicalURL}>
<meta property="og:image" content={ogImageURL}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="ABS Certifications & Advisory — certification consulting & advisory">
<meta property="og:locale" content="en_GB">
<meta property="og:locale:alternate" content="en_US">

<!-- ============ Twitter Card ============ -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImageURL}>
<meta name="twitter:image:alt" content="ABS Certifications & Advisory">

<!-- ============ Theme & PWA ============ -->
<meta name="theme-color" content="#081F4D">
<meta name="msapplication-TileColor" content="#081F4D">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

<!-- ============ Favicon: the site's "A" mark as real files (content review, N11) — favicon.ico holds
     16/32/48 px for browsers and Google (which needs a crawlable file, a multiple of 48 px) ============ -->
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">

<!-- ============ Performance: DNS prefetch for the one third-party link used site-wide ============ -->
<link rel="dns-prefetch" href="https://wa.me">

<!-- ============ Fonts and icons: self-hosted (content review, N19), so visitors' browsers don't contact
     Google or jsDelivr. Same families, weights and subsets as before; font-display=swap. ============ -->
<link rel="stylesheet" href="/fonts/fonts.css" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="/fonts/fonts.css"></noscript>
<link rel="stylesheet" href="/vendor/tabler-icons-2.47.0/tabler-icons.min.css" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="/vendor/tabler-icons-2.47.0/tabler-icons.min.css"></noscript>

<!-- ============ Schema.org structured data: Organization + WebSite ============ -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(orgSchema)} />

<!-- Per-page <head> additions (hero preload, page-specific JSON-LD) -->
<slot name="head" />
</head>
<body>

<!-- Skip-to-content link for accessibility/keyboard users -->
<a href="#main-content" class="skip-link">Skip to content</a>

<!-- ============ TOP BAR ============ -->
<div class="topbar">
  <div class="container">
    <div class="topbar-left">
      <a href="mailto:info@abscerts.com"><i class="ti ti-mail"></i>info@abscerts.com</a>
    </div>
    <div class="topbar-right">
      <a href="tel:+919821696444"><i class="ti ti-phone"></i>+91 98216 96444</a>
    </div>
  </div>
</div>

<!-- ============ HEADER ============ -->
<header class="header" role="banner">
  <div class="container">
    <a href="/" class="logo" aria-label="ABS Certifications & Advisory — home">
      <img src="/logo-mark.png" class="logo-img" alt="ABS Certifications & Advisory" width="95" height="43">
    </a>
    <nav class="nav" aria-label="Primary navigation">
      <a href="/" id="nav-home" class:list={[{ active: path === '/' }]}>Home</a>
      <a href="/about" class:list={[{ active: path === '/about' }]}>About</a>
      <a href="/services" id="megaTrigger" class:list={["mega-trigger", { active: path.startsWith('/services') }]} aria-haspopup="true" aria-expanded="false">Services <i class="ti ti-chevron-down" style="font-size:14px"></i></a>
      <a href="/#industries">Industries</a>
      <a href="/process" class:list={[{ active: path === '/process' }]}>Process</a>
      <a href="/blog" class:list={[{ active: path.startsWith('/blog') }]}>Blog</a>
      <a href="/faq" class:list={[{ active: path === '/faq' }]}>FAQ</a>
      <a href="/contact" id="nav-contact" class:list={[{ active: path === '/contact' }]}>Contact</a>
      <div class="nav-ctas">
        <button class="btn btn-primary" onclick="openQuoteModal()">Request quote <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></button>
        <button class="btn btn-partner" onclick="openPartnerModal()">Become a Partner <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></button>
      </div>
    </nav>
    <button class="hamburger" onclick="toggleMobileNav()" aria-label="Open menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
  <MegaMenu />
</header>

<main id="main-content">
  <slot />
</main>

<!-- ============ FOOTER ============ -->
<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="logo">
          <img src="/logo-mark.png" class="logo-img" alt="ABS Certifications & Advisory" width="95" height="43" loading="lazy" decoding="async">
        </div>
        <p class="footer-tag">Consulting and advisory firm helping organisations across UK, EU, US, Middle East and APAC achieve certification. Transparent pricing, global delivery.</p>
        <div class="footer-newsletter">
          <label for="footer-newsletter-email">Stay in the loop</label>
          <!-- Sign-ups go to ABS's marketing inbox via /api/newsletter, labelled "footer" (content review §8.4) -->
          <form data-form="newsletter" data-success="Thanks — we've received your sign-up.">
            <input type="hidden" name="type" value="email">
            <input type="hidden" name="source" value="footer">
            <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp-field">
            <div class="footer-newsletter-input">
              <input type="email" id="footer-newsletter-email" name="email" placeholder="your@email.com" autocomplete="email" required>
              <button type="submit" aria-label="Subscribe" data-submit data-sending="…"><i class="ti ti-arrow-right"></i></button>
            </div>
            <div data-form-status></div>
          </form>
          <p class="footer-newsletter-note">Occasional updates from ABS. See our <a href="/privacy">Privacy policy</a>.</p>
        </div>
      </div>
      <div>
        <h3>Services</h3>
        <ul class="footer-links">
          {footerCategories.map((cat) => (
            <li><a href={`/services/${cat.id}`}>{cat.data.shortName}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h3>Company</h3>
        <ul class="footer-links">
          <li><a href="/about">About us</a></li>
          <li><a href="/process">Our process</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/resources">Free resources</a></li>
          <li><a href="/blog">Blog & insights</a></li>
        </ul>
      </div>
      <div>
        <h3>Contact</h3>
        <div class="footer-contact-item"><i class="ti ti-phone"></i><span>+91 98216 96444</span></div>
        <div class="footer-contact-item"><i class="ti ti-mail"></i><span>info@abscerts.com</span></div>
        <div class="footer-contact-item"><i class="ti ti-map-pin"></i><span>178, Anaya House, Connaught Place,<br>New Delhi 110001, India</span></div>
      </div>
    </div>
    <p class="footer-disclaimer" style="max-width:100%;margin:32px 0 0;padding-top:20px;border-top:1px solid rgba(255,255,255,0.12);font-size:12.5px;line-height:1.6;color:rgba(255,255,255,0.66);">ABS Certifications &amp; Advisory is a consulting and advisory firm, working alongside independent certification bodies and audit firms to help organisations achieve and maintain certification.</p>
    <div class="footer-bottom">
      <span>© 2004–{year} ABS Certifications & Advisory. All rights reserved.</span>
      <div class="footer-social">
        <a href="#" aria-label="LinkedIn"><i class="ti ti-brand-linkedin"></i></a>
        <a href="#" aria-label="X"><i class="ti ti-brand-x"></i></a>
        <a href="#" aria-label="YouTube"><i class="ti ti-brand-youtube"></i></a>
      </div>
      <span><a href="/privacy">Privacy</a></span>
    </div>
  </div>
</footer>

<!-- ============ MOBILE NAV ============ -->
<div class="mobile-nav-backdrop" id="mobileNavBackdrop" onclick="toggleMobileNav()"></div>
<aside class="mobile-nav" id="mobileNav" inert>
  <button class="mobile-nav-close" onclick="toggleMobileNav()" aria-label="Close menu"><i class="ti ti-x"></i></button>
  <a href="/" onclick="toggleMobileNav()">Home</a>
  <a href="/about" onclick="toggleMobileNav()">About</a>
  <MobileServicesNav />
  <a href="/#industries" onclick="toggleMobileNav()">Industries</a>
  <a href="/process" onclick="toggleMobileNav()">Process</a>
  <a href="/blog" onclick="toggleMobileNav()">Blog</a>
  <a href="/faq" onclick="toggleMobileNav()">FAQ</a>
  <a href="/contact" onclick="toggleMobileNav()">Contact</a>
  <div class="mobile-nav-cta">
    <button class="btn btn-primary" onclick="openQuoteModal(); toggleMobileNav();">Request a quote <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></button>
    <button class="btn btn-partner" onclick="openPartnerModal(); toggleMobileNav();">Become a Partner <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></button>
    <a class="btn btn-outline" href="/contact" onclick="toggleMobileNav()"><i class="ti ti-calendar-event"></i>Book a meeting</a>
  </div>
  <div class="mobile-nav-contact">
    <a href="tel:+919821696444" class="mobile-nav-contact-item"><i class="ti ti-phone"></i>+91 98216 96444</a>
    <a href="mailto:info@abscerts.com" class="mobile-nav-contact-item"><i class="ti ti-mail"></i>info@abscerts.com</a>
  </div>
</aside>

<!-- ============ FLOATING WIDGETS ============ -->
<div class="float-stack">
  <button class="float-btn scroll-top" id="scrollTopBtn" onclick="scrollToTop()" aria-label="Scroll to top">
    <i class="ti ti-arrow-up"></i>
    <span class="tooltip">Back to top</span>
  </button>
  <button class="float-btn whatsapp" onclick="openWhatsApp()" aria-label="WhatsApp us">
    <i class="ti ti-brand-whatsapp"></i>
    <span class="tooltip">Chat on WhatsApp</span>
  </button>
  <a class="float-btn call" href="tel:+919821696444" aria-label="Call us on +91 98216 96444">
    <i class="ti ti-phone"></i>
    <span class="tooltip">Call us</span>
  </a>
</div>

<!-- ============ QUOTE MODAL ============ -->
<div class="modal-backdrop" id="quoteModal" inert onclick="if(event.target===this) closeQuoteModal()">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="quoteModalTitle">
    <div class="modal-header">
      <button class="modal-close" onclick="closeQuoteModal()" aria-label="Close"><i class="ti ti-x"></i></button>
      <p class="eyebrow">Free · No obligation</p>
      <h2 id="quoteModalTitle">Request a quote</h2>
      <p>Tell us your scope. We'll send a fixed-price proposal within 24 hours.</p>
    </div>
    <div class="modal-body">
      <form data-form="quote">
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp-field">
        <div class="form-row">
          <div>
            <label for="qm-name">Full name *</label>
            <input type="text" id="qm-name" name="name" class="form-control" placeholder="Jane Smith" required>
          </div>
          <div>
            <label for="qm-email">Work email *</label>
            <input type="email" id="qm-email" name="email" class="form-control" placeholder="jane@company.com" required>
          </div>
        </div>
        <div class="form-row">
          <div>
            <label for="qm-company">Company *</label>
            <input type="text" id="qm-company" name="company" class="form-control" placeholder="Acme Ltd" required>
          </div>
          <div>
            <label for="qm-country">Country *</label>
            <select id="qm-country" name="country" class="form-control" required>
              <option value="">Select country</option>
              <option>India</option>
              <option>United Kingdom</option>
              <option>United States</option>
              <option>United Arab Emirates</option>
              <option>Germany</option>
              <option>Saudi Arabia</option>
              <option>Other</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label for="qm-service">Service of interest *</label>
          <select id="qm-service" name="service" class="form-control" required>
            <option value="">Select a service</option>
            <option>Cyber Security</option>
            <option>ISO Certifications</option>
            <option>CMMI &amp; Process</option>
            <option>Food Industry</option>
            <option>Training &amp; Professional Development</option>
            <option>Data Analytics</option>
            <option>Agile Transformation</option>
            <option>Third Party Inspection</option>
            <option>HR Services</option>
            <option>Other</option>
          </select>
        </div>
        <div class="form-row">
          <div>
            <label for="qm-employees">Employee count</label>
            <select id="qm-employees" name="employeeCount" class="form-control">
              <option value="">Select…</option>
              <option>1–10</option>
              <option>11–50</option>
              <option>51–200</option>
              <option>201–1000</option>
              <option>1000+</option>
            </select>
          </div>
          <div>
            <label for="qm-sites">Number of sites</label>
            <select id="qm-sites" name="sites" class="form-control">
              <option value="">Select…</option>
              <option>1</option>
              <option>2–5</option>
              <option>6–20</option>
              <option>20+</option>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div>
            <label for="qm-industry">Industry</label>
            <select id="qm-industry" name="industry" class="form-control">
              <option value="">Select…</option>
              <option>Technology &amp; SaaS</option>
              <option>Manufacturing</option>
              <option>Healthcare &amp; Medical</option>
              <option>Financial Services</option>
              <option>Other</option>
            </select>
          </div>
          <div>
            <label for="qm-existing">Existing certification</label>
            <input type="text" id="qm-existing" name="existingCert" class="form-control" placeholder="e.g. ISO 9001, or None">
          </div>
        </div>
        <div class="form-group">
          <label for="qm-target">Target certification date</label>
          <input type="text" id="qm-target" name="targetDate" class="form-control" placeholder="e.g. Q4 2026, or a specific date">
        </div>
        <div class="form-group">
          <label for="qm-message">Your expectations</label>
          <textarea id="qm-message" name="message" class="form-control" placeholder="Tell us what you'd like to achieve — the standard or scope, your timing, and anything else we should know."></textarea>
        </div>
        <button type="submit" class="form-submit" data-submit>Send request <i class="ti ti-arrow-right"></i></button>
        <div data-form-status></div>
        <div class="modal-trust">
          <span><i class="ti ti-clock"></i>24-hour response</span>
          <span><i class="ti ti-shield-check"></i>Confidential</span>
          <span><i class="ti ti-currency-pound"></i>Multi-currency</span>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- ============ PARTNER MODAL ============ -->
<div class="modal-backdrop" id="partnerModal" inert onclick="if(event.target===this) closePartnerModal()">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="partnerModalTitle">
    <div class="modal-header">
      <button class="modal-close" onclick="closePartnerModal()" aria-label="Close"><i class="ti ti-x"></i></button>
      <p class="eyebrow">Partnerships</p>
      <h2 id="partnerModalTitle">Become a Partner</h2>
      <p>Interested in working with ABS? Tell us a little about yourself and how you would like to work together, and our team will be in touch.</p>
    </div>
    <div class="modal-body">
      <form data-form="partner">
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp-field">
        <div class="form-row">
          <div>
            <label for="pm-name">Full name *</label>
            <input type="text" id="pm-name" name="name" class="form-control" placeholder="Jane Smith" autocomplete="name" required>
          </div>
          <div>
            <label for="pm-email">Email *</label>
            <input type="email" id="pm-email" name="email" class="form-control" placeholder="jane@company.com" autocomplete="email" required>
          </div>
        </div>
        <div class="form-row">
          <div>
            <label for="pm-phone">Phone (with country code) *</label>
            <input type="tel" id="pm-phone" name="phone" class="form-control" placeholder="+44 20 7946 0958" autocomplete="tel" required>
          </div>
          <div>
            <label for="pm-company">Company name</label>
            <input type="text" id="pm-company" name="company" class="form-control" placeholder="Optional" autocomplete="organization">
          </div>
        </div>
        <div class="form-group">
          <label for="pm-country">Country *</label>
          <input type="text" id="pm-country" name="country" class="form-control" placeholder="e.g. United Kingdom" autocomplete="country-name" required>
        </div>
        <div class="form-group">
          <label for="pm-message">Message *</label>
          <textarea id="pm-message" name="message" class="form-control" placeholder="Tell us about yourself and the partnership you have in mind." required></textarea>
        </div>
        <button type="submit" class="form-submit" data-submit>Send enquiry <i class="ti ti-arrow-right"></i></button>
        <div data-form-status></div>
        <p class="modal-privacy">We use your details only to respond to your enquiry — see our <a href="/privacy">Privacy Policy</a>.</p>
      </form>
    </div>
  </div>
</div>

<!-- ============ EXIT-INTENT POPUP ============ -->
<div class="exit-popup" id="exitPopup" inert onclick="if(event.target===this) closeExitPopup()">
  <div class="exit-popup-card">
    <div class="exit-popup-banner">
      <button class="exit-popup-close" onclick="closeExitPopup()" aria-label="Close"><i class="ti ti-x"></i></button>
      <div class="exit-popup-icon"><i class="ti ti-gift"></i></div>
      <h3>Before you go — let us <em>help</em></h3>
      <p>Drop your details and we'll send a free certification roadmap tailored to your business. No spam, ever.</p>
    </div>
    <div class="exit-popup-body">
      <div class="exit-popup-tabs">
        <button class="exit-popup-tab active" onclick="switchExitTab(this, 'email')">Email me</button>
        <button class="exit-popup-tab" onclick="switchExitTab(this, 'phone')">Call me back</button>
      </div>
      <form id="exitFormEmail" data-form="newsletter">
        <input type="hidden" name="type" value="email">
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp-field">
        <div class="exit-popup-input-row">
          <input type="email" name="email" class="exit-popup-input" placeholder="your@email.com" aria-label="Your email address" required>
          <button type="submit" class="exit-popup-submit" data-submit>Send <i class="ti ti-arrow-right"></i></button>
        </div>
        <div data-form-status></div>
      </form>
      <form id="exitFormPhone" style="display:none" data-form="newsletter">
        <input type="hidden" name="type" value="phone">
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp-field">
        <div class="exit-popup-input-row">
          <input type="tel" name="phone" class="exit-popup-input" placeholder="+44 20 7946 0958" aria-label="Your phone number" required>
          <button type="submit" class="exit-popup-submit" data-submit>Call me <i class="ti ti-arrow-right"></i></button>
        </div>
        <div data-form-status></div>
      </form>
      <p class="exit-popup-disclaimer">By submitting, you agree to ABS's <a href="/privacy">privacy policy</a>.</p>
    </div>
  </div>
</div>

<script src="/scripts/global.js" is:inline></script>
</body>
</html>
