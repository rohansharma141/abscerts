---
import { getCollection, render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import CTABanner from '../components/sections/CTABanner.astro';
import ServiceTile from '../components/ui/ServiceTile.astro';

// Category landing layout. Phase 4b: real educational body, smart-tile grid and
// search-within-category. Industries + FAQ sections remain deferred (TODO markers).
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const pageTitle = d.seo?.title ?? `${d.title} | ABS Certifications`;
const pageDescription = d.seo?.description ?? d.description;
const canonical = new URL(`/services/${entry.id}`, Astro.site).href;

// Services contained in this category, sorted by order.
const services = (await getCollection('services'))
  .filter((s) => s.data.category === entry.id)
  .sort((a, b) => a.data.order - b.data.order);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Services', item: new URL('/services', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: d.title, item: canonical },
  ],
};
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: d.title,
  description: d.description,
  url: canonical,
  ...(services.length > 0 && {
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: services.map((s, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: s.data.shortName,
        url: new URL(`/services/${s.id}`, Astro.site).href,
      })),
    },
  }),
};
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonical}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionSchema)} />
  </Fragment>

  <!-- COMPACT HERO — text + small framed photo -->
  <section class="cat-hero cat-hero--media">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span>/</span> <a href="/services">Services</a> <span>/</span> <strong>{d.title}</strong>
      </nav>
      <div class="cat-hero-grid">
        <div class="cat-hero-text">
          <p class="eyebrow">Services</p>
          <h1>{d.title}</h1>
          <p class="cat-hero-sub">{d.description}</p>
        </div>
        {d.image && (
          <div class="cat-hero-media">
            <img src={d.image} alt={d.imageAlt ?? d.title} width="640" height="480" loading="eager" />
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- SEARCH + TILE GRID -->
  <section class="section section-tint" style="padding:40px 0 72px;">
    <div class="container">
      <h2 class="visually-hidden">Services in {d.shortName}</h2>
      {services.length > 0 ? (
        <Fragment>
          <div class="category-search">
            <i class="ti ti-search"></i>
            <input
              type="search"
              data-category-search
              placeholder={`Search ${d.shortName.toLowerCase()} services...`}
              aria-label={`Search within ${d.shortName}`}
            />
          </div>
          <div class="service-tile-grid">
            {services.map((s) => <ServiceTile service={s} />)}
          </div>
          <div class="search-empty-state" data-search-empty-state hidden>
            <p>No services match your search.</p>
          </div>
        </Fragment>
      ) : (
        <div class="category-empty-state">
          <p>Services in this category are being added. <a href="/contact">Contact us</a> to discuss your specific requirement.</p>
        </div>
      )}
    </div>
  </section>

  <!-- EDUCATIONAL CONTENT -->
  <section class="section section-white" style="padding:72px 0;">
    <div class="container narrow cat-prose">
      <article class="prose">
        <Content />
      </article>
    </div>
  </section>

  <!-- TODO Phase 4f or later: "Industries we serve in this category" section -->
  <!-- TODO Phase 4f or later: Category-level FAQ section -->

  <CTABanner />
</BaseLayout>
