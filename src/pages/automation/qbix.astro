---
// QBIX — ABS's compliance automation platform (Nov 2026). Brief: feedback/QBIX-PAGE-BRIEF-2026-11-18.md (facts §3,
// forbidden claims §4, draft copy §5). Rohan's decisions, 18 Nov 2026: URL /automation/qbix; menu Services →
// Automation → QBIX; CTA "Book a consultation" opening the basic consultation form (no drop-downs).
// Rules that bite here: QBIX in capitals; ABS/QBIX never issue certificates or reports (a licensed CPA firm issues
// SOC 2 reports, an independent certification body certifies ISO/IEC 27001/27701, HIPAA is compliance); only the four
// standards below; no AI, integration product names, pricing, availability, timelines, statistics or customer names;
// "SOC 2 certification" only inside FAQ 5, which explains the phrase. The panels are illustrations, not screenshots.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConsultationModal from '../../components/ui/ConsultationModal.astro';

const title = 'QBIX — Compliance Automation for SOC 2 & ISO 27001 | ABS';
const description =
  'QBIX by ABS collects evidence, checks controls continuously and keeps you audit-ready for SOC 2, ISO/IEC 27001, ISO/IEC 27701 and HIPAA.';
const canonical = new URL('/automation/qbix', Astro.site).href;
const keywords =
  'QBIX, compliance automation platform, SOC 2 compliance software, ISO 27001 compliance automation, audit readiness, continuous compliance monitoring, evidence collection, auditor portal, ISO 27701, HIPAA';

const steps = [
  { title: 'Connect', icon: 'ti-cloud', text: 'Connect QBIX to your systems: identity, cloud, code, HR and devices.' },
  { title: 'Collect', icon: 'ti-database', text: 'Evidence arrives automatically from those systems, and your team adds documents and records by hand. Both count the same.' },
  { title: 'Check', icon: 'ti-list-check', text: 'QBIX tests your controls continuously and tells you, in plain words, what passes, what does not, and the next step.' },
  { title: 'Prove', icon: 'ti-shield-check', text: 'When the audit comes, your auditor gets secure, read-only access to exactly the standard and period under audit, and every number traces back to its evidence.' },
];

const features = [
  { title: 'Readiness at a glance', icon: 'ti-dashboard', text: "Every standard's progress in one view, its trend over time, and where you stood on any past date." },
  { title: 'Evidence that proves itself', icon: 'ti-lock', text: 'Each file and fact fingerprinted and kept in a history that cannot be quietly changed.' },
  { title: 'One control, many standards', icon: 'ti-layout-grid', text: 'Map a control once and let it count towards every standard it serves.' },
  { title: 'Policies your people sign', icon: 'ti-checklist', text: 'Templates, review and approval, version comparison, and one-click acknowledgement with live coverage.' },
  { title: 'People, training and devices', icon: 'ti-users-group', text: 'Your directory, org chart, background checks, trainings and device settings in one place; joiners and leavers handled daily.' },
  { title: 'Risks, vendors and systems', icon: 'ti-alert-triangle', text: 'Registers with assessment, treatment and reviews, with each risk linked to the vendors behind it.' },
  { title: 'Access reviews', icon: 'ti-user-check', text: 'Scheduled reviews of who has access to what, decided, signed off and confirmed.' },
  { title: 'Tasks that keep moving', icon: 'ti-clipboard-check', text: 'Owners, due dates and a personal dashboard; overdue work escalates to managers.' },
  { title: 'Audits without the scramble', icon: 'ti-user-search', text: 'A secure auditor portal, requests and findings with their own conversations, review through sign-off, and audit-ready reports and exports.' },
];

// Lead with SOC 2 and ISO/IEC 27001 (ABS's core services); each links to ABS's own service page (brief §5.5).
const standards = [
  {
    name: 'SOC 2',
    scope: 'Security criteria',
    icon: 'ti-shield-check',
    text: 'QBIX maps the SOC 2 Security criteria to controls and keeps the evidence current through the period your auditor observes. Your SOC 2 report is issued by a licensed CPA firm.',
    href: '/services/soc-2',
    link: 'How ABS helps with SOC 2',
  },
  {
    name: 'ISO/IEC 27001',
    scope: 'Information security',
    icon: 'ti-shield-lock',
    text: 'The management-system clauses and the Annex A controls, with a Statement of Applicability. Certification is by an independent certification body.',
    href: '/services/iso-27001',
    link: 'How ABS helps with ISO/IEC 27001',
  },
  {
    name: 'ISO/IEC 27701',
    scope: 'Privacy information',
    icon: 'ti-user-shield',
    text: 'Privacy information management, extending ISO/IEC 27001. Certification is by an independent certification body.',
    href: '/services/iso-27701',
    link: 'How ABS helps with ISO/IEC 27701',
  },
  {
    name: 'HIPAA',
    scope: 'Health information',
    icon: 'ti-stethoscope',
    text: 'The HIPAA requirements for protecting health information, mapped to controls and evidence, so you can show your compliance.',
    href: '/services/hipaa',
    link: 'How ABS helps with HIPAA',
  },
];

const audiences = [
  { icon: 'ti-cloud-lock', text: 'Technology and SaaS companies whose customers ask for a SOC 2 report or ISO/IEC 27001.' },
  { icon: 'ti-briefcase', text: 'IT and business service providers working with enterprise clients.' },
  { icon: 'ti-building-hospital', text: 'Healthcare and health-tech businesses protecting patient data under HIPAA.' },
  { icon: 'ti-user-shield', text: 'Companies extending ISO/IEC 27001 to privacy with ISO/IEC 27701.' },
];

const safeguards = [
  { icon: 'ti-database', text: "Each company's data is separated at the database level." },
  { icon: 'ti-users', text: 'Every user sees what their role allows: Admins run the programme, and Employees see only their own policies, trainings and tasks.' },
  { icon: 'ti-user-search', text: 'Auditors get time-limited, read-only access to one standard and one period, with every access logged.' },
  { icon: 'ti-lock', text: "Evidence, policies and the platform's own audit log are append-only: history is kept, never rewritten." },
];

// One list renders the visible FAQ and the FAQPage data, word for word (site rule). `cta` marks the words in the
// answer that open the consultation form.
const faqs: { question: string; answer: string; cta?: string }[] = [
  {
    question: 'What is QBIX?',
    answer:
      "QBIX is ABS's compliance automation platform. It collects evidence for SOC 2, ISO/IEC 27001, ISO/IEC 27701 and HIPAA, checks your controls continuously, and keeps you ready for your audit.",
  },
  {
    question: 'Which standards does QBIX cover?',
    answer:
      'QBIX covers SOC 2 (the Security criteria), ISO/IEC 27001, ISO/IEC 27701 and HIPAA, and it is built to take on more standards as your programme grows. One control can count towards several of them at once.',
  },
  {
    question: 'How does QBIX collect evidence?',
    answer:
      'Through integrations with your systems (identity, cloud, code, HR and devices) and from the documents and records your team adds. Both count the same.',
  },
  {
    question: 'Who issues our SOC 2 report or ISO certificate?',
    answer:
      'A licensed CPA firm issues your SOC 2 report, and an independent certification body certifies ISO/IEC 27001 and ISO/IEC 27701. QBIX keeps you ready and gives that auditor a secure, read-only view of exactly what the audit covers; ABS guides you through the whole journey.',
  },
  {
    question: 'Is SOC 2 a certification?',
    answer:
      "SOC 2 is often called a certification. Formally it is an attestation: a licensed CPA firm examines your controls under the AICPA's standards and issues a SOC 2 report, Type I for a point in time and Type II for a period. QBIX keeps the evidence for that report current every day.",
  },
  {
    question: 'Can one set of controls serve more than one standard?',
    answer: 'Yes. QBIX maps each control to every requirement it satisfies, across standards.',
  },
  {
    question: 'How do our employees take part?',
    answer:
      'They sign in to acknowledge policies, complete their trainings and see their own tasks and devices, and nothing more.',
  },
  {
    question: 'Is our data kept separate from other companies?',
    answer:
      "Yes. Each company's data is separated at the database level, and every user sees only what their role allows.",
  },
  {
    question: 'How do we get started?',
    answer:
      'Get in touch with ABS. We set up your QBIX workspace with the standards you are pursuing, connect your systems and guide your first readiness review. Book a consultation to begin.',
    cta: 'Book a consultation',
  },
];

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': `${canonical}#software`,
  name: 'QBIX',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: faqs[0].answer,
  url: canonical,
  publisher: { '@id': 'https://www.abscerts.com/#organization' },
  featureList: features.map((f) => f.title),
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
// "Automation" has no page of its own yet (/automation redirects here), so the trail skips it.
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Services', item: new URL('/services', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: 'QBIX', item: canonical },
  ],
};

const num = (i: number) => `/ ${String(i + 1).padStart(2, '0')}`;
---

<BaseLayout title={title} description={description} canonical={canonical} keywords={keywords}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <!-- HERO -->
  <section class="page-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb" style="margin-bottom:24px">
        <a href="/">Home</a> <span>/</span> <a href="/services">Services</a> <span>/</span> <b class="crumb-text">Automation</b> <span>/</span> <strong>QBIX</strong>
      </nav>
      <div class="page-hero-grid">
        <div>
          <p class="eyebrow" style="margin-bottom:24px">QBIX · compliance automation</p>
          <h1>Be ready when your customers ask for <em>proof</em>.</h1>
          <p>QBIX, the compliance automation platform from ABS, collects the evidence for SOC 2, ISO/IEC 27001, ISO/IEC 27701 and HIPAA, checks your controls continuously and shows you exactly where you stand, so you're ready when a customer asks you to prove it.</p>
          <div class="detail-cta">
            <button class="btn btn-primary" onclick="openConsultModal()">Book a consultation <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></button>
            <a class="btn btn-outline" href="#how-qbix-works">See how QBIX works <span class="btn-icon-square"><i class="ti ti-arrow-right"></i></span></a>
          </div>
        </div>

        <figure class="qbix-ill qbix-ill--hero" role="img" aria-label="Illustration of a QBIX readiness view: SOC 2 progress shown as a ring, with progress bars for SOC 2, ISO/IEC 27001, ISO/IEC 27701 and HIPAA.">
          <div class="qbix-ill-top">
            <span class="qbix-ill-label">Your company · Readiness</span>
            <span class="qbix-ill-tag">Illustration</span>
          </div>
          <div class="qbix-ring-row">
            <svg class="qbix-ring" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
              <circle cx="60" cy="60" r="52" class="qbix-ring-track" />
              <circle cx="60" cy="60" r="52" class="qbix-ring-value" stroke-dasharray="254.9 326.7" transform="rotate(-90 60 60)" />
              <text x="60" y="68" text-anchor="middle" class="qbix-ring-text">78%</text>
            </svg>
            <div class="qbix-ring-meta">
              <span class="qbix-ring-title">SOC 2</span>
              <span class="qbix-ring-sub">Security criteria · requirements met</span>
              <span class="qbix-chip qbix-chip--next">3 next steps</span>
            </div>
          </div>
          <ul class="qbix-bars">
            <li><span class="qbix-bar-name">SOC 2 (Security)</span><span class="qbix-bar"><span style="width:78%"></span></span></li>
            <li><span class="qbix-bar-name">ISO/IEC 27001</span><span class="qbix-bar"><span style="width:64%"></span></span></li>
            <li><span class="qbix-bar-name">ISO/IEC 27701</span><span class="qbix-bar"><span style="width:41%"></span></span></li>
            <li><span class="qbix-bar-name">HIPAA</span><span class="qbix-bar"><span style="width:52%"></span></span></li>
          </ul>
        </figure>
      </div>
    </div>
  </section>

  <!-- FROM SCATTERED PROOF TO ONE CLEAR PICTURE -->
  <section class="section section-tint qbix-sec">
    <div class="container">
      <div class="qbix-split">
        <div>
          <p class="eyebrow" style="margin-bottom:24px">Why QBIX</p>
          <h2>From scattered proof to one <em>clear picture</em>.</h2>
          <p class="qbix-lead">Preparing for an audit usually means screenshots in shared folders, policies in email threads, a spreadsheet of who signed what, and a busy few weeks before the auditor arrives.</p>
          <p class="qbix-lead">QBIX brings it into one place: much of your evidence gathers itself, every requirement shows its status, and the audit trail builds as you work, so your team spends its time on security, not on paperwork.</p>
        </div>
        <figure class="qbix-ill" role="img" aria-label="Illustration of a QBIX control list: two controls passing, one failing with its next step, and one expired document with its next step.">
          <div class="qbix-ill-top">
            <span class="qbix-ill-label">Your company · Controls</span>
            <span class="qbix-ill-tag">Illustration</span>
          </div>
          <ul class="qbix-controls">
            <li>
              <i class="ti ti-circle-check qbix-ok"></i>
              <span class="qbix-control-name">MFA for admin accounts</span>
              <span class="qbix-chip qbix-chip--pass">Passing</span>
            </li>
            <li>
              <i class="ti ti-circle-check qbix-ok"></i>
              <span class="qbix-control-name">Security policy acknowledged</span>
              <span class="qbix-chip qbix-chip--pass">Passing</span>
            </li>
            <li>
              <i class="ti ti-alert-triangle qbix-bad"></i>
              <span class="qbix-control-name">Laptop disk encryption</span>
              <span class="qbix-chip qbix-chip--fail">Failing</span>
              <span class="qbix-control-next">Next step: fix a setting on two devices</span>
            </li>
            <li>
              <i class="ti ti-clock qbix-due"></i>
              <span class="qbix-control-name">Hosting vendor agreement</span>
              <span class="qbix-chip qbix-chip--next">Expired</span>
              <span class="qbix-control-next">Next step: renew an expired document</span>
            </li>
          </ul>
        </figure>
      </div>
    </div>
  </section>

  <!-- HOW QBIX WORKS -->
  <section class="section section-white qbix-sec" id="how-qbix-works">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left">
          <p class="eyebrow">How it works</p>
          <h2>How QBIX <em>works</em>.</h2>
        </div>
        <div class="section-head-right">
          <p>Four steps, from the systems you already use to the day your auditor signs off.</p>
        </div>
      </div>
      <div class="qbix-grid qbix-grid--4">
        {steps.map((s, i) => (
          <div class="qbix-card">
            <div class="qbix-card-top">
              <span class="qbix-card-icon"><i class={`ti ${s.icon}`}></i></span>
              <span class="qbix-card-num">{num(i)}</span>
            </div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT QBIX DOES -->
  <section class="section section-tint qbix-sec">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left">
          <p class="eyebrow">What it does</p>
          <h2>What QBIX <em>does</em>.</h2>
        </div>
        <div class="section-head-right">
          <p>One place for the evidence, policies, people and reviews behind your standards, kept current every day.</p>
        </div>
      </div>
      <div class="qbix-grid qbix-grid--3">
        {features.map((f) => (
          <div class="qbix-card">
            <div class="qbix-card-top">
              <span class="qbix-card-icon"><i class={`ti ${f.icon}`}></i></span>
            </div>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- THE STANDARDS YOU NEED -->
  <section class="section section-white qbix-sec">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left">
          <p class="eyebrow">Standards</p>
          <h2>The standards <em>you need</em>.</h2>
        </div>
        <div class="section-head-right">
          <p>QBIX covers SOC 2 (the Security criteria), ISO/IEC 27001, ISO/IEC 27701 and HIPAA, and it is built to take on more standards as your programme grows.</p>
        </div>
      </div>
      <div class="qbix-grid qbix-grid--4">
        {standards.map((s) => (
          <div class="qbix-card qbix-card--standard">
            <div class="qbix-card-top">
              <span class="qbix-card-icon"><i class={`ti ${s.icon}`}></i></span>
              <span class="qbix-card-num">{s.scope}</span>
            </div>
            <h3>{s.name}</h3>
            <p>{s.text}</p>
            <a class="qbix-card-link" href={s.href}>{s.link} <i class="ti ti-arrow-right"></i></a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BUILT FOR THE AUDIT ITSELF -->
  <section class="section section-tint qbix-sec">
    <div class="container">
      <div class="qbix-split">
        <div>
          <p class="eyebrow" style="margin-bottom:24px">Audits</p>
          <h2>Built for the <em>audit itself</em>.</h2>
          <p class="qbix-lead">Your auditor works inside QBIX with time-limited, read-only access to the standard and period under audit: nothing more, and every access logged.</p>
          <p class="qbix-lead">Requests, questions and findings arrive with their own conversation, your team answers with files, and the audit moves through review to sign-off in one place. From the same live records, QBIX produces audit-ready reports and exports, and keeps your SOC 2 system description and ISO/IEC 27001 Statement of Applicability versioned alongside them.</p>
        </div>
        <figure class="qbix-ill" role="img" aria-label="Illustration of an auditor's request in QBIX and your team's reply with a file attached.">
          <div class="qbix-ill-top">
            <span class="qbix-ill-label">SOC 2 Type II audit · Review</span>
            <span class="qbix-ill-tag">Illustration</span>
          </div>
          <div class="qbix-access"><i class="ti ti-lock"></i>Read-only · audit period only · every access logged</div>
          <div class="qbix-msg">
            <span class="qbix-msg-who">Request from your auditor</span>
            <span class="qbix-msg-text">Please share the quarterly user access review for the audit period.</span>
          </div>
          <div class="qbix-msg qbix-msg--team">
            <span class="qbix-msg-who">Reply from your team</span>
            <span class="qbix-file"><i class="ti ti-file-certificate"></i>access-review-q3-signed-off.pdf</span>
            <span class="qbix-msg-text">Signed off by the reviewers; removals confirmed by the next sync.</span>
          </div>
          <div class="qbix-note"><i class="ti ti-message-circle"></i>Private team note · visible to your team only</div>
        </figure>
      </div>
    </div>
  </section>

  <!-- QBIX AND ABS, TOGETHER -->
  <section class="section section-white qbix-sec">
    <div class="container narrow qbix-together">
      <span class="qbix-card-icon qbix-card-icon--lg"><i class="ti ti-heart-handshake"></i></span>
      <h2>QBIX and ABS, <em>together</em>.</h2>
      <p class="qbix-lead">QBIX is ABS's own platform, and it is how we work with you. Our consultants see the same live picture you do, guide your team through each gap, and prepare you for the independent audit. QBIX keeps your evidence current long after the report or certificate arrives, ready for the next audit and the next customer who asks.</p>
    </div>
  </section>

  <!-- WHO QBIX IS FOR -->
  <section class="section section-tint qbix-sec">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left">
          <p class="eyebrow">Who it's for</p>
          <h2>Who QBIX <em>is for</em>.</h2>
        </div>
        <div class="section-head-right">
          <p>Businesses whose customers, partners or regulators expect proof that their information is protected.</p>
        </div>
      </div>
      <div class="qbix-grid qbix-grid--4">
        {audiences.map((a) => (
          <div class="qbix-card qbix-card--audience">
            <span class="qbix-card-icon"><i class={`ti ${a.icon}`}></i></span>
            <p>{a.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- YOUR DATA, KEPT APART AND KEPT HONEST -->
  <section class="section section-white qbix-sec">
    <div class="container">
      <div class="qbix-split">
        <div>
          <p class="eyebrow" style="margin-bottom:24px">Security</p>
          <h2>Your data, kept apart and <em>kept honest</em>.</h2>
          <ul class="qbix-points">
            {safeguards.map((s) => (
              <li><span class="qbix-card-icon"><i class={`ti ${s.icon}`}></i></span><span>{s.text}</span></li>
            ))}
          </ul>
        </div>
        <figure class="qbix-ill" role="img" aria-label="Illustration of an evidence record in QBIX with its SHA-256 fingerprint and an append-only history of versions.">
          <div class="qbix-ill-top">
            <span class="qbix-ill-label">Evidence · Access review</span>
            <span class="qbix-ill-tag">Illustration</span>
          </div>
          <span class="qbix-file qbix-file--lg"><i class="ti ti-file-certificate"></i>access-review-q3-signed-off.pdf</span>
          <div class="qbix-hash"><span>SHA-256</span><code>3f9a 61c2 8b04 … e04b 7d15</code></div>
          <span class="qbix-ill-label qbix-ill-label--sub">History</span>
          <ol class="qbix-history">
            <li><span class="qbix-chip qbix-chip--next">v2</span>Correction, pointing to v1</li>
            <li><span class="qbix-chip qbix-chip--muted">v1</span>Original record, kept</li>
          </ol>
          <div class="qbix-note"><i class="ti ti-lock"></i>Append-only: nothing is silently edited or deleted</div>
        </figure>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section-tint qbix-sec">
    <div class="container narrow">
      <p class="eyebrow" style="margin-bottom:24px">FAQ</p>
      <h2 class="qbix-faq-head">Questions about <em>QBIX</em>.</h2>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <div class:list={['faq-item', { open: i === 0 }]}>
            <button class="faq-q" onclick="toggleFaq(this)">{f.question}<span class="icon"><i class="ti ti-plus"></i></span></button>
            <div class="faq-a">
              {f.cta ? (
                <>
                  {f.answer.slice(0, f.answer.indexOf(f.cta))}
                  <button type="button" class="faq-inline-link" onclick="openConsultModal()">{f.cta}</button>
                  {f.answer.slice(f.answer.indexOf(f.cta) + f.cta.length)}
                </>
              ) : f.answer}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CLOSING BAND (the site's CTA band, with the consultation form and no pricing or reply-time lines) -->
  <section class="cta-banner qbix-cta">
    <div class="cta-banner-bg"></div>
    <div class="cta-banner-overlay"></div>
    <div class="container">
      <p class="eyebrow">QBIX</p>
      <h2>See QBIX with your own standards <em>in mind</em>.</h2>
      <p>Book a consultation with ABS to talk through the standards you're working towards and how QBIX fits your programme.</p>
      <div class="cta-buttons">
