---
import { getCollection } from 'astro:content';
import ServiceDetailLayout from '../../layouts/ServiceDetailLayout.astro';
import CategoryLandingLayout from '../../layouts/CategoryLandingLayout.astro';

export async function getStaticPaths() {
  const services = await getCollection('services');
  const categories = await getCollection('categories');

  const categorySlugs = new Set(categories.map((c) => c.id));

  return [
    // Categories first. On a slug collision (the Phase-2 `cmmi` service shares the
    // `cmmi` category slug), the category page wins — per migration brief Section 4,
    // the category is the destination and the service stays in the collection only
    // for menu/related references.
    ...categories.map((c) => ({ params: { slug: c.id }, props: { entry: c, kind: 'category' } })),
    ...services
      .filter((s) => !categorySlugs.has(s.id))
      .map((s) => ({ params: { slug: s.id }, props: { entry: s, kind: 'service' } })),
  ];
}

const { entry, kind } = Astro.props;
---

{kind === 'service' && <ServiceDetailLayout entry={entry} />}
{kind === 'category' && <CategoryLandingLayout entry={entry} />}
