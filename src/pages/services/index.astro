---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/sections/CTABanner.astro';

const title = 'Certification Consulting & Advisory Services | ABS Certifications';
const description =
  'Certification consulting and advisory across ISO, cyber security, food & industry, CMMI, data analytics, training, inspection and more — for organisations operating across regulated markets.';

const allServices = await getCollection('services');

// Category cards — the primary way to browse (Phase 4b).
const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const catCards = categories.map((c) => ({
  slug: c.id,
  shortName: c.data.shortName,
  icon: c.data.icon,
  description: c.data.description,
  count: allServices.filter((s) => s.data.category === c.id).length,
}));

// A–Z power-user view — every service, grouped by first letter of shortName.
const azServices = [...allServices].sort((a, b) => a.data.shortName.localeCompare(b.data.shortName));
const azGroups: Record<string, typeof azServices> = {};
for (const s of azServices) {
  const letter = s.data.shortName.charAt(0).toUpperCase();
  (azGroups[letter] ??= []).push(s);
}
const azLetters = Object.keys(azGroups).sort();
---

<BaseLayout title={title} description={description}>
  <!-- COMPACT HERO -->
  <section class="cat-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span>/</span> <strong>Services</strong>
      </nav>
      <p class="eyebrow">Services</p>
      <h1>Our services</h1>
      <p class="cat-hero-sub">Independent audits for organisations operating across regulated markets — browse by category below.</p>
    </div>
  </section>

  <!-- CATEGORY CARDS -->
  <section class="section section-tint" style="padding:56px 0 72px;">
    <div class="container">
      <div class="cat-cards">
        {catCards.map((c) => (
          <a href={`/services/${c.slug}`} class="cat-card">
            <span class="cat-card-icon"><i class={`ti ${c.icon}`}></i></span>
            <h3>{c.shortName}</h3>
            <p class="cat-card-desc">{c.description}</p>
            <span class="cat-card-all">View all{c.count > 0 ? ` ${c.count}` : ''} <i class="ti ti-arrow-right"></i></span>
          </a>
        ))}
      </div>

      <!-- A–Z power-user view -->
      <details class="services-az">
        <summary>Browse all services A–Z</summary>
        <div class="services-az-body">
          {azLetters.map((letter) => (
            <div class="services-az-group">
              <span class="services-az-letter">{letter}</span>
              <ul>
                {azGroups[letter].map((s) => (
                  <li><a href={`/services/${s.id}`}>{s.data.shortName} — {s.data.title}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </details>
    </div>
  </section>

  <CTABanner />
</BaseLayout>
