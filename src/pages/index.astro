---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ui/ServiceCard.astro';
import IndustryCard from '../components/ui/IndustryCard.astro';
import CTABanner from '../components/sections/CTABanner.astro';

const title = 'ABS Certifications & Advisory | ISO, SOC 2 & Compliance Consulting for global businesses';
const description =
  'Certification consulting and advisory for organisations in UK, EU, US and Middle East. We help you achieve ISO 9001, 27001, 14001, 45001, SOC 2, PCI DSS and CMMI. Fixed-price quote in 24 hours.';

// Home services grid: v7's 6 generic service *categories* (NOT the ISO-standard
// collection entries — they don't map 1:1). Kept as literal ServiceCard props so the
// home grid stays byte-identical to v7. The /services index is the collection-driven one.
const homeServices = [
  { tag: 'Most requested', num: '/ 01', href: '/services/iso-certifications', image: '/images/service-iso-9001.jpg', imageAlt: 'ISO 9001 quality management system documentation', title: 'ISO management systems', description: 'Globally accepted certifications covering quality, environment, security, safety and energy management.', tags: ['ISO 9001', '14001', '27001', '45001', '+ more'] },
  { tag: 'Fast-track 8 weeks', num: '/ 02', href: '/services/cyber-security', image: '/images/home-cyber-security.jpg', imageAlt: 'SOC 2 cyber security and information security audit', title: 'Cyber security & SOC 2', description: 'End-to-end security assurance from SOC 2 readiness to penetration testing and PCI DSS audit.', tags: ['SOC 2', 'VAPT', 'GDPR', 'NIST', 'PCI DSS'] },
  { tag: 'IT & software', num: '/ 03', href: '/services/cmmi', image: '/images/service-cmmi-dev.jpg', imageAlt: 'CMMI appraisal for IT services and software development', title: 'CMMI appraisals', description: 'CMMI maturity level 2 and 3 readiness assessments, gap analysis and ATM support for IT services.', tags: ['CMMI ML2', 'CMMI ML3', 'ATM'] },
  { tag: 'Advisory', num: '/ 04', href: '/services/data-analytics', image: '/images/home-data-analytics.jpg', imageAlt: 'Data analytics dashboard for compliance reporting', title: 'Data analytics', description: 'Data management, process automation, decision analytics and visualisation for compliance-driven teams.', tags: ['Analytics', 'Automation', 'Reporting'] },
  { tag: 'Training & rollout', num: '/ 05', href: '/services/agile-transformation', image: '/images/service-agile-coaching.jpg', imageAlt: 'Agile planning board tracking sprint work across columns', title: 'Agile transformation', description: 'Scrum, Kanban and Lean training plus enterprise rollouts. Certified trainers and experienced practitioners.', tags: ['Scrum', 'Kanban', 'Lean'] },
  { tag: 'Inspections', num: '/ 06', href: '/services/third-party-inspection', image: '/images/home-third-party-inspection.jpg', imageAlt: 'Third-party factory inspection and supplier audit', title: 'Third-party inspection', description: 'Independent pre-shipment, factory, and supplier inspections to verify quality at source.', tags: ['Pre-shipment', 'Factory', 'Supplier'] },
];

// Home industries grid IS collection-driven (the 4 industries map 1:1 to v7's cards).
const featuredIndustries = (await getCollection('industries'))
  .filter((i) => i.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const industryNum = (i: number) => `/ ${String(i + 1).padStart(2, '0')}`;

// "Trusted by" client logos — add real, PERMISSIONED client logos here (drop files in
// public/images/clients/). The strip stays hidden until at least one entry exists, so
// no placeholder/fake logos ever show. Requires written client permission before use.
const clientLogos: { name: string; logo: string }[] = [
  // { name: 'Acme Ltd', logo: '/images/clients/acme.svg' },
];

// Service node from v7's schema @graph — emitted on the home page.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'ISO Certification Services',
  provider: { '@id': 'https://www.abscerts.com/#organization' },
  areaServed: ['United Kingdom', 'United States', 'United Arab Emirates', 'Germany', 'Saudi Arabia'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Certification standards',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'ISO 9001 Quality Management certification' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'ISO 27001 Information Security certification' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'ISO 14001 Environmental Management certification' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'ISO 45001 Occupational Health & Safety certification' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'SOC 2 Type I and Type II audits' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'PCI DSS audit' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'CMMI appraisal' } },
    ],
  },
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/images/hero-1.jpg" imagesrcset="/images/hero-1-768.jpg 768w, /images/hero-1-1280.jpg 1280w, /images/hero-1.jpg 1920w" imagesizes="100vw" fetchpriority="high">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
  </Fragment>

  <!-- HERO CAROUSEL -->
  <section class="hero" aria-label="Hero carousel">
    <div class="hero-carousel" id="heroCarousel" role="region" aria-roledescription="carousel">

      <!-- Slide 1 -->
      <article class="hero-slide active" aria-roledescription="slide" aria-label="Slide 1 of 3">
        <div class="hero-slide-img">
          <img src="/images/hero-1.jpg" alt="ABS Certifications consultants in client boardroom delivering ISO audit"
               srcset="/images/hero-1-768.jpg 768w, /images/hero-1-1280.jpg 1280w, /images/hero-1.jpg 1920w" sizes="100vw"
               fetchpriority="high" decoding="async" width="1920" height="1080">
        </div>
        <div class="hero-slide-content">
          <div class="container">
            <div class="hero-slide-inner">
              <div class="hero-slide-meta">
                <span class="hero-slide-meta-item">ISO · SOC 2 · CMMI</span>
                <span class="hero-slide-meta-item">Est. 2008</span>
                <span class="hero-slide-meta-item">40+ countries</span>
              </div>
              <h1>Global ISO, SOC 2 and <em>compliance advisory</em> services.</h1>
              <p class="hero-slide-sub">We help organisations implement effective management systems, close compliance gaps and prepare for independent certification, attestation and regulatory assessments.</p>
              <div class="hero-slide-cta">
                <button class="btn btn-primary" onclick="openQuoteModal()">Request a fixed-price proposal <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></button>
                <a class="btn btn-outline" href="/contact"><i class="ti ti-calendar-event"></i>Book a 30-min call</a>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- Slide 2 -->
      <article class="hero-slide" aria-roledescription="slide" aria-label="Slide 2 of 3">
        <div class="hero-slide-img">
          <img src="/images/hero-2.jpg" alt="ISO management system documentation and quality audit"
               srcset="/images/hero-2-768.jpg 768w, /images/hero-2-1280.jpg 1280w, /images/hero-2.jpg 1920w" sizes="100vw"
               loading="lazy" decoding="async" width="1920" height="1080">
        </div>
        <div class="hero-slide-content">
          <div class="container">
            <div class="hero-slide-inner">
              <div class="hero-slide-meta">
                <span class="hero-slide-meta-item">Fixed-price proposals</span>
                <span class="hero-slide-meta-item">24-hour response</span>
              </div>
              <h1>A clear quote in <em>24 hours</em>, never an open invoice.</h1>
              <p class="hero-slide-sub">Tell us your scope. We send a transparent, fixed-fee proposal in your preferred currency — GBP, EUR, USD or AED. No scope creep, no surprise travel charges.</p>
              <div class="hero-slide-cta">
                <button class="btn btn-primary" onclick="openQuoteModal()">Request your quote <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></button>
                <a class="btn btn-outline" href="/contact"><i class="ti ti-message-circle"></i>Talk to a specialist</a>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- Slide 3 -->
      <article class="hero-slide" aria-roledescription="slide" aria-label="Slide 3 of 3">
        <div class="hero-slide-img">
          <img src="/images/hero-3.jpg" alt="Audit preparation desk with laptop, checklist and documents"
               srcset="/images/hero-3-768.jpg 768w, /images/hero-3-1280.jpg 1280w, /images/hero-3.jpg 1920w" sizes="100vw"
               loading="lazy" decoding="async" width="1920" height="1080">
        </div>
        <div class="hero-slide-content">
          <div class="container">
            <div class="hero-slide-inner">
              <div class="hero-slide-meta">
                <span class="hero-slide-meta-item">Consultants in 12 countries</span>
                <span class="hero-slide-meta-item">On-site or remote</span>
              </div>
              <h1>Auditors based <em>near you</em>, audits delivered in your time zone.</h1>
              <p class="hero-slide-sub">Local consultants across the UK, EU, Middle East and North America. No expensive international travel charges. Multi-language support in English, Arabic, German and French.</p>
              <div class="hero-slide-cta">
                <a class="btn btn-primary" href="/contact">Find auditors in your region <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></a>
                <button class="btn btn-outline" onclick="openQuoteModal()"><i class="ti ti-world"></i>Get a regional quote</button>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- Controls -->
      <div class="hero-controls">
        <div class="container">
          <div class="hero-dots" role="tablist" aria-label="Choose hero slide">
            <button class="hero-dot active" onclick="goToSlide(0)" aria-label="Go to slide 1" role="tab"></button>
            <button class="hero-dot" onclick="goToSlide(1)" aria-label="Go to slide 2" role="tab"></button>
            <button class="hero-dot" onclick="goToSlide(2)" aria-label="Go to slide 3" role="tab"></button>
          </div>
          <div class="hero-counter" aria-live="polite">
            <strong id="heroCurrent">01</strong><span>/</span>03
          </div>
          <div class="hero-arrows">
            <button class="hero-arrow" onclick="prevSlide()" aria-label="Previous slide"><i class="ti ti-arrow-left"></i></button>
            <button class="hero-arrow" onclick="nextSlide()" aria-label="Next slide"><i class="ti ti-arrow-right"></i></button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HERO STATS STRIP -->
  <section class="hero-stats" aria-label="Key statistics">
    <div class="container">
      <div class="hero-stats-grid">
        <div class="hero-stat">
          <div class="num">1,200<small>+</small></div>
          <div class="label">Certificates issued globally</div>
        </div>
        <div class="hero-stat">
          <div class="num">40<small>+</small></div>
          <div class="label">Countries served on-site</div>
        </div>
        <div class="hero-stat">
          <div class="num">18<small>yrs</small></div>
          <div class="label">In certification & advisory</div>
        </div>
        <div class="hero-stat">
          <div class="num">12<small>+</small></div>
          <div class="label">Consultants across regions</div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUSTED BY (client logos) — hidden until real, permissioned logos are added to clientLogos[] -->
  {clientLogos.length > 0 && (
    <section class="trusted-strip">
      <div class="container">
        <p class="trusted-label">Trusted by teams at</p>
        <div class="trusted-logos">
          {clientLogos.map((c) => <img src={c.logo} alt={c.name} height="34" loading="lazy" decoding="async">)}
        </div>
      </div>
    </section>
  )}

  <!-- MARQUEE -->
  <section class="marquee">
    <div class="marquee-track">
      <span class="marquee-item"><i class="ti ti-certificate"></i>ISO consulting</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">🇬🇧 United Kingdom</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item"><i class="ti ti-certificate"></i>Audit readiness</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">🇦🇪 United Arab Emirates</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item"><i class="ti ti-certificate"></i>Gap analysis</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">🇩🇪 Germany</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item"><i class="ti ti-certificate"></i>Training & advisory</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">🇺🇸 United States</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item"><i class="ti ti-certificate"></i>SOC 2 specialist</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">🇸🇦 Saudi Arabia</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item"><i class="ti ti-certificate"></i>ISO consulting</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">🇬🇧 United Kingdom</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item"><i class="ti ti-certificate"></i>Audit readiness</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">🇦🇪 United Arab Emirates</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item"><i class="ti ti-certificate"></i>Gap analysis</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">🇩🇪 Germany</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item"><i class="ti ti-certificate"></i>Training & advisory</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">🇺🇸 United States</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item"><i class="ti ti-certificate"></i>SOC 2 specialist</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">🇸🇦 Saudi Arabia</span>
      <span class="marquee-dot"></span>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section section-white" id="services">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left">
          <p class="eyebrow">01 / Our services</p>
          <h2>Certifications that <em>matter</em> to the markets you sell into.</h2>
        </div>
        <div class="section-head-right">
          <p>We provide consulting, implementation and audit-readiness support. Formal ISO certificates are issued by independent accredited certification bodies following successful completion of the certification audit — we prepare you for it, so your customers in London, Frankfurt, Dubai or Austin can trust what's printed on your certificate.</p>
          <button class="btn btn-outline" onclick="openQuoteModal()">Talk to a specialist <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></button>
        </div>
      </div>

      <div class="services-grid">
        {homeServices.map((s) => (
          <ServiceCard
            tag={s.tag}
            num={s.num}
            image={s.image}
            imageAlt={s.imageAlt}
            title={s.title}
            description={s.description}
            tags={s.tags}
            detailHref={s.href}
          />
        ))}
      </div>

      <div class="section-cta">
        <a class="btn btn-primary" href="/services">See all services <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></a>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section section-tint" id="process">
    <div class="container">
      <div class="process-wrap">
        <div class="process-img">
          <img src="/images/home-process.jpg" alt="ABS consultant in discussion with a client team" loading="lazy" decoding="async" width="900" height="1125">
          <div class="process-img-tag">
            <i class="ti ti-bolt"></i>
            <span>Typical implementation timeline: 11 weeks</span>
          </div>
        </div>
        <div>
          <p class="eyebrow" style="margin-bottom:24px">02 / How we work</p>
          <h2 style="margin-bottom:24px">A clear path, from <em>first conversation</em> to certificate in hand.</h2>
          <p style="font-size:16px; margin-bottom:40px; max-width:540px;">No mystery, no surprise charges. Here's exactly what working with ABS looks like — and how soon you can expect your certificate.</p>

          <div class="process-steps">
            <div class="process-step">
              <div class="process-step-num">/ 01</div>
              <div class="process-step-body">
                <h3>Free quote</h3>
                <p>Tell us your scope. We send a fixed-price proposal within 24 hours, in your preferred currency.</p>
                <span class="process-step-meta"><i class="ti ti-clock"></i>Within 1 business day</span>
              </div>
            </div>
            <div class="process-step">
              <div class="process-step-num">/ 02</div>
              <div class="process-step-body">
                <h3>Gap assessment</h3>
                <p>We assess your current position against the standard and map every gap. Remote or on-site, your choice.</p>
                <span class="process-step-meta"><i class="ti ti-clock"></i>Week 2–4</span>
              </div>
            </div>
            <div class="process-step">
              <div class="process-step-num">/ 03</div>
              <div class="process-step-body">
                <h3>Certification audit</h3>
                <p>Your certification body carries out the audit. We prepare your team and evidence, and support you throughout.</p>
                <span class="process-step-meta"><i class="ti ti-clock"></i>Week 8–10</span>
              </div>
            </div>
            <div class="process-step">
              <div class="process-step-num">/ 04</div>
              <div class="process-step-body">
                <h3>Certificate issued</h3>
                <p>Your certification body issues the certificate — recognised by customers worldwide.</p>
                <span class="process-step-meta"><i class="ti ti-clock"></i>Week 11</span>
              </div>
            </div>
          </div>

          <div style="margin-top:40px; display:flex; gap:14px; flex-wrap:wrap;">
            <button class="btn btn-primary" onclick="openQuoteModal()">Start your compliance project <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></button>
            <a class="btn btn-outline" href="/process">See the full process <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="section section-white" id="industries">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left">
          <p class="eyebrow">03 / Industries</p>
          <h2>Specialised expertise across your <em>sector</em>.</h2>
        </div>
        <div class="section-head-right">
          <p>Our consultants don't just know the standards — they know your industry. From SaaS startups to global manufacturers, we bring sector context to every engagement.</p>
        </div>
      </div>

      <div class="industries-grid">
        {featuredIndustries.map((ind, i) => (
          <IndustryCard
            num={industryNum(i)}
            title={ind.data.title}
            description={ind.data.description}
            image={ind.data.image}
            imageAlt={ind.data.imageAlt}
            href={`/industries/${ind.id}`}
          />
        ))}
      </div>

      <div style="text-align:center; margin-top:48px;">
        <button class="btn btn-outline" onclick="openQuoteModal()">Don't see your industry? Talk to us <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></button>
      </div>
    </div>
  </section>

  <!-- WHY US -->
  <section class="section section-tint">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left">
          <p class="eyebrow">04 / Why ABS</p>
          <h2>Designed for buyers <em>outside India</em>.</h2>
        </div>
        <div class="section-head-right">
          <p>We've built ABS specifically to serve overseas clients. That means time-zone-friendly delivery, fixed-fee transparent pricing in your currency, and consultants based near you.</p>
        </div>
      </div>

      <div class="why-wrap">
        <div class="why-image">
          <img src="/images/home-why-us.jpg" alt="Modern global office serving international certification clients" loading="lazy" decoding="async" width="800" height="1000">
        </div>
        <div class="why-items">
          <div class="why-item">
            <div class="why-num">/ 01</div>
            <div>
              <h3>Time-zone friendly delivery</h3>
              <p>Dedicated coordinators working across GMT, CET, EST and GST hours. You're never waiting overnight for a response.</p>
              <a href="/contact" class="why-item-link">Book a call in your time zone <i class="ti ti-arrow-right" style="font-size:12px"></i></a>
            </div>
          </div>
          <div class="why-item">
            <div class="why-num">/ 02</div>
            <div>
              <h3>Transparent fixed pricing</h3>
              <p>Fixed-fee proposals in GBP, EUR, USD or AED. No scope creep, no hidden travel charges, no surprises at invoice time.</p>
              <a href="#" class="why-item-link" onclick="openQuoteModal(); return false;">Request a price guide <i class="ti ti-arrow-right" style="font-size:12px"></i></a>
            </div>
          </div>
          <div class="why-item">
            <div class="why-num">/ 03</div>
            <div>
              <h3>Consultants in 12 countries</h3>
              <p>On-site audits without expensive international travel. Local language support across English, Arabic, German, French and more.</p>
              <a href="/contact" class="why-item-link">See auditor coverage <i class="ti ti-arrow-right" style="font-size:12px"></i></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- NUMBERS STRIP (dark blue) -->
  <section class="numbers-strip">
    <div class="container">
      <div class="numbers-strip-head">
        <div>
          <p class="eyebrow">05 / By the numbers</p>
          <h2 style="margin-top:24px">Built on a foundation of <em style="color:var(--glow)">measurable trust</em>.</h2>
        </div>
        <a class="btn btn-light" href="/contact">Talk to our team <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></a>
      </div>
      <div class="numbers-grid">
        <div class="numbers-item">
          <div class="numbers-num">1,200<small>+</small></div>
          <div class="numbers-label">Certification and compliance engagements supported across the UK, EU, US, Middle East and APAC since 2008.</div>
        </div>
        <div class="numbers-item">
          <div class="numbers-num">98<small>%</small></div>
          <div class="numbers-label">First-time certification success rate for organisations completing our implementation programme.</div>
        </div>
        <div class="numbers-item">
          <div class="numbers-num">24<small>h</small></div>
          <div class="numbers-label">Typical response time for enquiries — within one working day.</div>
        </div>
        <div class="numbers-item">
          <div class="numbers-num">11<small>wk</small></div>
          <div class="numbers-label">Typical implementation timeline to certification readiness for ISO standards.</div>
        </div>
      </div>
      <p style="margin-top:16px;font-size:12px;opacity:0.6;">Figures updated July 2026.</p>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section section-white">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left">
          <p class="eyebrow">06 / Client outcomes</p>
          <h2>What clients say after <em>working with us</em>.</h2>
        </div>
      </div>

      <div class="testimonial-feature">
        <div class="testimonial-img">
          <img src="/images/home-testimonial-steelbird.jpg" alt="SteelBird Helmets — ISO 27001 certification and consulting client of ABS" loading="lazy" decoding="async" width="800" height="1000">
          <div class="testimonial-img-flag">🇮🇳 India</div>
        </div>
        <div>
          <span class="testimonial-quote-mark">"</span>
          <blockquote>We took certification and consulting services for ISO 27001 certification, and ABS provided us the complete solution — within budget and on time.</blockquote>
          <div class="testimonial-author">
            <div class="testimonial-author-avatar">SB</div>
            <div class="testimonial-author-info">
              <p>SteelBird Helmets</p>
              <p>Customer</p>
            </div>
          </div>
          <button class="btn btn-outline" onclick="openQuoteModal()">Get a free quote <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></button>
        </div>
      </div>

      <div class="testimonial-mini-grid">
        <div class="testimonial-mini">
          <p>ABS auditors are well qualified, and their knowledge helped us improve our QMS and our way of working.</p>
