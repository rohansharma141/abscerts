---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ui/ServiceCard.astro';
import IndustryCard from '../components/ui/IndustryCard.astro';
import CTABanner from '../components/sections/CTABanner.astro';

const title = 'ABS Certifications & Advisory | ISO 9001, 27001, SOC 2 certification for global businesses';
const description =
  'Independent ISO certification body for organisations in UK, EU, US and Middle East. IAS/IAF accredited audits for ISO 9001, 27001, 14001, 45001, SOC 2, PCI DSS, CMMI. Fixed-price quote in 24 hours. 1,200+ certificates issued.';

// Home services grid: v7's 6 generic service *categories* (NOT the ISO-standard
// collection entries — they don't map 1:1). Kept as literal ServiceCard props so the
// home grid stays byte-identical to v7. The /services index is the collection-driven one.
const homeServices = [
  { tag: 'Most requested', num: '/ 01', image: 'https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=700&q=80', imageAlt: 'ISO 9001 quality management system documentation', title: 'ISO management systems', description: 'Globally accepted certifications covering quality, environment, security, safety and energy management.', tags: ['ISO 9001', '14001', '27001', '45001', '+ more'] },
  { tag: 'Fast-track 8 weeks', num: '/ 02', image: 'https://images.unsplash.com/photo-1614064641938-3bbee52942c7?w=700&q=80', imageAlt: 'SOC 2 cyber security and information security audit', title: 'Cyber security & SOC 2', description: 'End-to-end security assurance from SOC 2 readiness to penetration testing and PCI DSS audit.', tags: ['SOC 2', 'VAPT', 'GDPR', 'NIST', 'PCI DSS'] },
  { tag: 'IT & software', num: '/ 03', image: 'https://images.unsplash.com/photo-1551434678-e076c223a692?w=700&q=80', imageAlt: 'CMMI appraisal for IT services and software development', title: 'CMMI appraisals', description: 'CMMI maturity level 2 and 3 readiness assessments, gap analysis and ATM support for IT services.', tags: ['CMMI ML2', 'CMMI ML3', 'ATM'] },
  { tag: 'Advisory', num: '/ 04', image: 'https://images.unsplash.com/photo-1543286386-713bdd548da4?w=700&q=80', imageAlt: 'Data analytics dashboard for compliance reporting', title: 'Data analytics', description: 'Data management, process automation, decision analytics and visualisation for compliance-driven teams.', tags: ['Analytics', 'Automation', 'Reporting'] },
  { tag: 'Training & rollout', num: '/ 05', image: 'https://images.unsplash.com/photo-1552664730-d307ca884978?w=700&q=80', imageAlt: 'Agile transformation team workshop and training', title: 'Agile transformation', description: 'Scrum, SAFe and Kanban training plus enterprise rollouts. Certified trainers and lead auditors.', tags: ['Scrum', 'SAFe', 'Kanban'] },
  { tag: 'Inspections', num: '/ 06', image: 'https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?w=700&q=80', imageAlt: 'Third-party factory inspection and supplier audit', title: 'Third-party inspection', description: 'Independent pre-shipment, factory, and supplier inspections to verify quality at source.', tags: ['Pre-shipment', 'Factory', 'Supplier'] },
];

// Home industries grid IS collection-driven (the 4 industries map 1:1 to v7's cards).
const featuredIndustries = (await getCollection('industries'))
  .filter((i) => i.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const industryNum = (i: number) => `/ ${String(i + 1).padStart(2, '0')}`;

// Service node from v7's schema @graph — emitted on the home page.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'ISO Certification Services',
  provider: { '@id': 'https://www.abscerts.com/#organization' },
  areaServed: ['United Kingdom', 'United States', 'United Arab Emirates', 'Germany', 'Saudi Arabia'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Certification standards',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'ISO 9001 Quality Management certification' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'ISO 27001 Information Security certification' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'ISO 14001 Environmental Management certification' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'ISO 45001 Occupational Health & Safety certification' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'SOC 2 Type I and Type II audits' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'PCI DSS audit' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'CMMI appraisal' } },
    ],
  },
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <link rel="preload" as="image" href="https://images.unsplash.com/photo-1573164713988-8665fc963095?w=900&q=80" fetchpriority="high">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
  </Fragment>

  <!-- HERO CAROUSEL -->
  <section class="hero" aria-label="Hero carousel">
    <div class="hero-carousel" id="heroCarousel" role="region" aria-roledescription="carousel">

      <!-- Slide 1 -->
      <article class="hero-slide active" aria-roledescription="slide" aria-label="Slide 1 of 4">
        <div class="hero-slide-img">
          <img src="https://images.unsplash.com/photo-1573164713988-8665fc963095?w=1920&q=80" alt="ABS Certifications consultants in client boardroom delivering ISO audit"
               fetchpriority="high" decoding="async" width="1920" height="1080">
        </div>
        <div class="hero-slide-content">
          <div class="container">
            <div class="hero-slide-inner">
              <div class="hero-slide-meta">
                <span class="hero-slide-meta-item">IAS · IAF accredited</span>
                <span class="hero-slide-meta-item">Est. 2008</span>
                <span class="hero-slide-meta-item">40+ countries</span>
              </div>
              <h1>Certification that <em>opens doors</em> across the world.</h1>
              <p class="hero-slide-sub">From ISO 9001 to SOC 2, we help organisations across the UK, EU, US and Middle East achieve compliance with rigour and clarity.</p>
              <div class="hero-slide-cta">
                <button class="btn btn-primary" onclick="openQuoteModal()">Get a free quote <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></button>
                <a class="btn btn-outline" href="/contact"><i class="ti ti-calendar-event"></i>Book a 30-min call</a>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- Slide 2 -->
      <article class="hero-slide" aria-roledescription="slide" aria-label="Slide 2 of 4">
        <div class="hero-slide-img">
          <img src="https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=1920&q=80" alt="ISO management system documentation and quality audit"
               loading="lazy" decoding="async" width="1920" height="1080">
        </div>
        <div class="hero-slide-content">
          <div class="container">
            <div class="hero-slide-inner">
              <div class="hero-slide-meta">
                <span class="hero-slide-meta-item">Fixed-price proposals</span>
                <span class="hero-slide-meta-item">24-hour response</span>
              </div>
              <h1>A clear quote in <em>24 hours</em>, never an open invoice.</h1>
              <p class="hero-slide-sub">Tell us your scope. We send a transparent, fixed-fee proposal in your preferred currency — GBP, EUR, USD or AED. No scope creep, no surprise travel charges.</p>
              <div class="hero-slide-cta">
                <button class="btn btn-primary" onclick="openQuoteModal()">Request your quote <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></button>
                <a class="btn btn-outline" href="/contact"><i class="ti ti-message-circle"></i>Talk to a specialist</a>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- Slide 3 -->
      <article class="hero-slide" aria-roledescription="slide" aria-label="Slide 3 of 4">
        <div class="hero-slide-img">
          <img src="https://images.unsplash.com/photo-1518684079-3c830dcef090?w=1920&q=80" alt="Dubai skyline representing Middle East ISO certification reach"
               loading="lazy" decoding="async" width="1920" height="1080">
        </div>
        <div class="hero-slide-content">
          <div class="container">
            <div class="hero-slide-inner">
              <div class="hero-slide-meta">
                <span class="hero-slide-meta-item">Lead auditors in 12 countries</span>
                <span class="hero-slide-meta-item">On-site or remote</span>
              </div>
              <h1>Auditors based <em>near you</em>, audits delivered in your time zone.</h1>
              <p class="hero-slide-sub">Local lead auditors across the UK, EU, Middle East and North America. No expensive international travel charges. Multi-language support in English, Arabic, German and French.</p>
              <div class="hero-slide-cta">
                <a class="btn btn-primary" href="/contact">Find auditors in your region <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></a>
                <button class="btn btn-outline" onclick="openQuoteModal()"><i class="ti ti-world"></i>Get a regional quote</button>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- Slide 4 -->
      <article class="hero-slide" aria-roledescription="slide" aria-label="Slide 4 of 4">
        <div class="hero-slide-img">
          <img src="https://images.unsplash.com/photo-1614064641938-3bbee52942c7?w=1920&q=80" alt="SOC 2 and information security certificate verification"
               loading="lazy" decoding="async" width="1920" height="1080">
        </div>
        <div class="hero-slide-content">
          <div class="container">
            <div class="hero-slide-inner">
              <div class="hero-slide-meta">
                <span class="hero-slide-meta-item">Online certificate verification</span>
                <span class="hero-slide-meta-item">One-click validation</span>
              </div>
              <h1>Trust, <em>verified</em> in one click by anyone, anywhere.</h1>
              <p class="hero-slide-sub">Every ABS-issued certificate has a unique reference number. Buyers, partners and procurement teams can confirm validity instantly — no email back-and-forth required.</p>
              <div class="hero-slide-cta">
                <a class="btn btn-primary" href="/verify">Try the verifier <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></a>
                <button class="btn btn-outline" onclick="openQuoteModal()"><i class="ti ti-shield-check"></i>Become certified</button>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- Controls -->
      <div class="hero-controls">
        <div class="container">
          <div class="hero-dots" role="tablist" aria-label="Choose hero slide">
            <button class="hero-dot active" onclick="goToSlide(0)" aria-label="Go to slide 1" role="tab"></button>
            <button class="hero-dot" onclick="goToSlide(1)" aria-label="Go to slide 2" role="tab"></button>
            <button class="hero-dot" onclick="goToSlide(2)" aria-label="Go to slide 3" role="tab"></button>
            <button class="hero-dot" onclick="goToSlide(3)" aria-label="Go to slide 4" role="tab"></button>
          </div>
          <div class="hero-counter" aria-live="polite">
            <strong id="heroCurrent">01</strong><span>/</span>04
          </div>
          <div class="hero-arrows">
            <button class="hero-arrow" onclick="prevSlide()" aria-label="Previous slide"><i class="ti ti-arrow-left"></i></button>
            <button class="hero-arrow" onclick="nextSlide()" aria-label="Next slide"><i class="ti ti-arrow-right"></i></button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HERO STATS STRIP -->
  <section class="hero-stats" aria-label="Key statistics">
    <div class="container">
      <div class="hero-stats-grid">
        <div class="hero-stat">
          <div class="num">1,200<small>+</small></div>
          <div class="label">Certificates issued globally</div>
        </div>
        <div class="hero-stat">
          <div class="num">40<small>+</small></div>
          <div class="label">Countries served on-site</div>
        </div>
        <div class="hero-stat">
          <div class="num">18<small>yrs</small></div>
          <div class="label">In certification & advisory</div>
        </div>
        <div class="hero-stat">
          <div class="num">12<small>+</small></div>
          <div class="label">Lead auditors across regions</div>
        </div>
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <section class="marquee">
    <div class="marquee-track">
      <span class="marquee-item"><i class="ti ti-certificate"></i>IAS accredited</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">🇬🇧 United Kingdom</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item"><i class="ti ti-certificate"></i>IAF MLA signatory</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">🇦🇪 United Arab Emirates</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item"><i class="ti ti-certificate"></i>EGAC partner</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">🇩🇪 Germany</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item"><i class="ti ti-certificate"></i>UKAS-aligned</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">🇺🇸 United States</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item"><i class="ti ti-certificate"></i>SOC 2 specialist</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">🇸🇦 Saudi Arabia</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item"><i class="ti ti-certificate"></i>IAS accredited</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">🇬🇧 United Kingdom</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item"><i class="ti ti-certificate"></i>IAF MLA signatory</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">🇦🇪 United Arab Emirates</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item"><i class="ti ti-certificate"></i>EGAC partner</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">🇩🇪 Germany</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item"><i class="ti ti-certificate"></i>UKAS-aligned</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">🇺🇸 United States</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item"><i class="ti ti-certificate"></i>SOC 2 specialist</span>
      <span class="marquee-dot"></span>
      <span class="marquee-item">🇸🇦 Saudi Arabia</span>
      <span class="marquee-dot"></span>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section section-white" id="services">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left">
          <p class="eyebrow">01 / Our services</p>
          <h2>Certifications that <em>matter</em> to the markets you sell into.</h2>
        </div>
        <div class="section-head-right">
          <p>Every certification we issue is recognised internationally under the IAF Multilateral Recognition Arrangement — so your customers in London, Frankfurt, Dubai or Austin can trust what's printed on your certificate.</p>
          <button class="btn btn-outline" onclick="openQuoteModal()">Talk to a specialist <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></button>
        </div>
      </div>

      <div class="services-grid">
        {homeServices.map((s) => (
          <ServiceCard
            tag={s.tag}
            num={s.num}
            image={s.image}
            imageAlt={s.imageAlt}
            title={s.title}
            description={s.description}
            tags={s.tags}
          />
        ))}
      </div>

      <div class="section-cta">
        <a class="btn btn-primary" href="/contact#contact-form">See all services & request a tailored proposal <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></a>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section section-tint" id="process">
    <div class="container">
      <div class="process-wrap">
        <div class="process-img">
          <img src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=900&q=80" alt="ABS lead auditor consultation with client team" loading="lazy" decoding="async" width="900" height="1125">
          <div class="process-img-tag">
            <i class="ti ti-bolt"></i>
            <span>Average start to certificate: 11 weeks</span>
          </div>
        </div>
        <div>
          <p class="eyebrow" style="margin-bottom:24px">02 / How we work</p>
          <h2 style="margin-bottom:24px">A clear path, from <em>first conversation</em> to certificate in hand.</h2>
          <p style="font-size:16px; margin-bottom:40px; max-width:540px;">No mystery, no surprise charges. Here's exactly what working with ABS looks like — and how soon you can expect your certificate.</p>

          <div class="process-steps">
            <div class="process-step">
              <div class="process-step-num">/ 01</div>
              <div class="process-step-body">
                <h3>Free quote</h3>
                <p>Tell us your scope. We send a fixed-price proposal within 24 hours, in your preferred currency.</p>
                <span class="process-step-meta"><i class="ti ti-clock"></i>Within 1 business day</span>
              </div>
            </div>
            <div class="process-step">
              <div class="process-step-num">/ 02</div>
              <div class="process-step-body">
                <h3>Gap assessment</h3>
                <p>Stage 1 audit identifies what's needed against the standard. Remote or on-site, your choice.</p>
                <span class="process-step-meta"><i class="ti ti-clock"></i>Week 2–4</span>
              </div>
            </div>
            <div class="process-step">
              <div class="process-step-num">/ 03</div>
              <div class="process-step-body">
                <h3>Certification audit</h3>
                <p>Stage 2 audit performed by qualified lead auditors based in or near your region.</p>
                <span class="process-step-meta"><i class="ti ti-clock"></i>Week 8–10</span>
              </div>
            </div>
            <div class="process-step">
              <div class="process-step-num">/ 04</div>
              <div class="process-step-body">
                <h3>Certificate issued</h3>
                <p>Globally recognised certificate, verifiable online by your customers in one click.</p>
                <span class="process-step-meta"><i class="ti ti-clock"></i>Week 11</span>
              </div>
            </div>
          </div>

          <div style="margin-top:40px;">
            <button class="btn btn-primary" onclick="openQuoteModal()">Start your certification journey <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="section section-white" id="industries">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left">
          <p class="eyebrow">03 / Industries</p>
          <h2>Specialised expertise across your <em>sector</em>.</h2>
        </div>
        <div class="section-head-right">
          <p>Our auditors don't just know the standards — they know your industry. From SaaS startups to global manufacturers, we bring sector context to every engagement.</p>
        </div>
      </div>

      <div class="industries-grid">
        {featuredIndustries.map((ind, i) => (
          <IndustryCard
            num={industryNum(i)}
            title={ind.data.title}
            description={ind.data.description}
            image={ind.data.image}
            imageAlt={ind.data.imageAlt}
          />
        ))}
      </div>

      <div style="text-align:center; margin-top:48px;">
        <button class="btn btn-outline" onclick="openQuoteModal()">Don't see your industry? Talk to us <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></button>
      </div>
    </div>
  </section>

  <!-- WHY US -->
  <section class="section section-tint">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left">
          <p class="eyebrow">04 / Why ABS</p>
          <h2>Designed for buyers <em>outside India</em>.</h2>
        </div>
        <div class="section-head-right">
          <p>We've built ABS specifically to serve overseas clients. That means time-zone-friendly delivery, fixed-fee transparent pricing in your currency, and lead auditors based near you.</p>
        </div>
      </div>

      <div class="why-wrap">
        <div class="why-image">
          <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?w=800&q=80" alt="Modern global office serving international certification clients" loading="lazy" decoding="async" width="800" height="1000">
        </div>
        <div class="why-items">
          <div class="why-item">
            <div class="why-num">/ 01</div>
            <div>
              <h3>Time-zone friendly delivery</h3>
              <p>Dedicated coordinators working across GMT, CET, EST and GST hours. You're never waiting overnight for a response.</p>
              <a href="/contact" class="why-item-link">Book a call in your time zone <i class="ti ti-arrow-right" style="font-size:12px"></i></a>
            </div>
          </div>
          <div class="why-item">
            <div class="why-num">/ 02</div>
            <div>
              <h3>Transparent fixed pricing</h3>
              <p>Fixed-fee proposals in GBP, EUR, USD or AED. No scope creep, no hidden travel charges, no surprises at invoice time.</p>
              <a href="#" class="why-item-link" onclick="openQuoteModal(); return false;">Request a price guide <i class="ti ti-arrow-right" style="font-size:12px"></i></a>
            </div>
          </div>
          <div class="why-item">
            <div class="why-num">/ 03</div>
            <div>
              <h3>Lead auditors in 12 countries</h3>
              <p>On-site audits without expensive international travel. Local language support across English, Arabic, German, French and more.</p>
              <a href="/contact" class="why-item-link">See auditor coverage <i class="ti ti-arrow-right" style="font-size:12px"></i></a>
            </div>
          </div>
          <div class="why-item">
            <div class="why-num">/ 04</div>
            <div>
              <h3>Online certificate verification</h3>
              <p>Your customers and partners can verify your ABS-issued certificate instantly via our public verification portal.</p>
              <a href="/verify" class="why-item-link">Try the verifier now <i class="ti ti-arrow-right" style="font-size:12px"></i></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- NUMBERS STRIP (dark blue) -->
  <section class="numbers-strip">
    <div class="container">
      <div class="numbers-strip-head">
        <div>
          <p class="eyebrow">05 / By the numbers</p>
          <h2 style="margin-top:24px">Built on a foundation of <em style="color:var(--glow)">measurable trust</em>.</h2>
        </div>
        <a class="btn btn-light" href="/contact">Talk to our team <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></a>
      </div>
      <div class="numbers-grid">
        <div class="numbers-item">
          <div class="numbers-num">1,200<small>+</small></div>
          <div class="numbers-label">Certificates issued across UK, EU, US, Middle East and APAC since 2008.</div>
        </div>
        <div class="numbers-item">
          <div class="numbers-num">98<small>%</small></div>
          <div class="numbers-label">First-time pass rate across all certification standards we audit.</div>
        </div>
        <div class="numbers-item">
          <div class="numbers-num">24<small>h</small></div>
          <div class="numbers-label">Average response time for quote requests — even on weekends.</div>
        </div>
        <div class="numbers-item">
          <div class="numbers-num">11<small>wk</small></div>
          <div class="numbers-label">Median time from kick-off to issued certificate for ISO standards.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section section-white">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left">
          <p class="eyebrow">06 / Client outcomes</p>
          <h2>What clients say after <em>working with us</em>.</h2>
        </div>
      </div>

      <div class="testimonial-feature">
        <div class="testimonial-img">
          <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=800&q=80" alt="Sarah Henderson, CISO of London fintech client" loading="lazy" decoding="async" width="800" height="1000">
          <div class="testimonial-img-flag">🇬🇧 London, UK</div>
        </div>
        <div>
          <span class="testimonial-quote-mark">"</span>
