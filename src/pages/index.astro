---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ui/ServiceCard.astro';
import IndustryCard from '../components/ui/IndustryCard.astro';
import CTABanner from '../components/sections/CTABanner.astro';

const title = 'ISO, SOC 2 & Compliance Consulting | ABS Certifications';
const description =
  'Certification consulting for organisations in the UK, EU, US and Middle East — ISO 9001, 27001, SOC 2, PCI DSS and CMMI. Fixed-price proposal in 24 hours.';

// Years in operation: ABS has operated since 2004 (confirmed Sep 2026). Worked out at
// build time so the hero figure never goes out of date.
const FOUNDED = 2004;
const yearsActive = new Date().getFullYear() - FOUNDED;

// Home services grid: all 9 service categories, in the client's order (Sep 2026) —
// the same order as the mega-menu, /services and the footer (category `order`).
// Kept as literal ServiceCard props (richer copy and tag pills than the collection);
// the /services index is the collection-driven one.
const homeServices = [
  { tag: 'Fast-track 8 weeks', num: '/ 01', href: '/services/cyber-security', image: '/images/home-cyber-security.jpg', imageAlt: 'SOC 2 cyber security and information security readiness', title: 'Cyber Security', description: 'End-to-end security assurance from SOC 2 readiness to penetration testing and PCI DSS readiness.', tags: ['SOC 2', 'VAPT', 'GDPR', 'NIST', 'PCI DSS'] },
  { tag: 'Most requested', num: '/ 02', href: '/services/iso-certifications', image: '/images/service-iso-9001.jpg', imageAlt: 'ISO 9001 quality management system documentation', title: 'ISO Certifications', description: 'Globally accepted certifications covering quality, environment, security, safety and energy management.', tags: ['ISO 9001', '14001', '27001', '45001', '+ more'] },
  { tag: 'IT & software', num: '/ 03', href: '/services/cmmi', image: '/images/service-cmmi-dev.jpg', imageAlt: 'CMMI process maturity for IT services and software development', title: 'CMMI & Process', description: 'CMMI maturity level 2 and 3 readiness assessments, gap analysis and ATM support for IT services.', tags: ['CMMI ML2', 'CMMI ML3', 'ATM'] },
  { tag: 'Supply chain', num: '/ 04', href: '/services/industry-food-certifications', image: '/images/cat-industry-food-certifications.jpg', imageAlt: 'Food safety and industrial product compliance', title: 'Food Industry', description: 'HACCP, FSSC 22000, BRCGS, Halal and Kosher readiness, plus sector schemes such as IATF 16949 and CE marking.', tags: ['HACCP', 'FSSC 22000', 'BRCGS', 'Halal', '+ more'] },
  { tag: 'ABS Academy', num: '/ 05', href: '/services/management-system-training', image: '/images/cat-management-system-training.jpg', imageAlt: 'ISO management system lead auditor training course', title: 'Training & Professional Development', description: 'Awareness, internal auditor and lead auditor training across ISO management system standards.', tags: ['Awareness', 'Internal Auditor', 'Lead Auditor'] },
  { tag: 'Advisory', num: '/ 06', href: '/services/data-analytics', image: '/images/home-data-analytics.jpg', imageAlt: 'Data analytics dashboard for compliance reporting', title: 'Data Analytics', description: 'Data management, process automation, decision analytics and visualisation for compliance-driven teams.', tags: ['Analytics', 'Automation', 'Reporting'] },
  { tag: 'Training & rollout', num: '/ 07', href: '/services/agile-transformation', image: '/images/service-agile-coaching.jpg', imageAlt: 'Agile planning board tracking sprint work across columns', title: 'Agile Transformation', description: 'Scrum, Kanban and Lean training plus enterprise rollouts. Certified trainers and experienced practitioners.', tags: ['Scrum', 'Kanban', 'Lean'] },
  { tag: 'Inspections', num: '/ 08', href: '/services/third-party-inspection', image: '/images/home-third-party-inspection.jpg', imageAlt: 'Third-party factory inspection and supplier audit', title: 'Third Party Inspection', description: 'Independent pre-shipment, factory, and supplier inspections to verify quality at source.', tags: ['Pre-shipment', 'Factory', 'Supplier'] },
  { tag: 'People', num: '/ 09', href: '/services/hr-services', image: '/images/cat-hr-services.jpg', imageAlt: 'HR consulting and recruitment services', title: 'HR Services', description: 'Recruitment and HR consulting — helping organisations find the right people and build the HR practices to support them.', tags: ['Recruitment', 'HR consulting'] },
];

// Hero carousel. Only `show: true` slides are rendered; hidden slides are left out of the
// HTML entirely (not display:none), so their copy is never published or crawled.
// The first shown slide gets the <h1>, the LCP preload and fetchpriority=high.
type HeroImage = 'hero-1' | 'hero-2' | 'hero-3';
type HeroAction = { label: string; href?: string; icon?: string }; // no href → opens the quote modal
type HeroSlide = { show: boolean; image: HeroImage; meta?: string[]; headline: string; sub: string; primary: HeroAction; secondary: HeroAction };

const heroImageAlt: Record<HeroImage, string> = {
  'hero-1': 'Consultants and client team reviewing compliance documents in a meeting room',
  'hero-2': 'Compliance dashboards on dual monitors',
  'hero-3': 'Audit preparation desk with laptop, checklist and documents',
};

const heroSlides: HeroSlide[] = [
  // Client copy, Sep 2026 — headlines and sub-lines verbatim.
  {
    show: true, image: 'hero-2',
    headline: 'Smarter Compliance.<br class="hero-br"> <em>Powered by Automation.</em>',
    sub: 'Streamline compliance workflows, reduce manual effort, and accelerate readiness across ISO, SOC 2, cybersecurity, and regulatory frameworks.',
    primary: { label: 'Request a fixed-price proposal' },
    secondary: { label: 'Explore our services', icon: 'ti-layout-grid', href: '/services' },
  },
  {
    show: true, image: 'hero-1',
    headline: '<span class="nw">Be Tender-Ready.</span><br class="hero-br"> <span class="nw">Be Customer-Ready.</span><br class="hero-br"> <em class="nw">Be Growth-Ready.</em>',
    sub: 'Strengthen your organisation with recognised certifications that demonstrate capability, compliance and trust when customers and evaluators are making critical supplier decisions.',
    primary: { label: 'Request your quote' },
    secondary: { label: 'Talk to a specialist', icon: 'ti-message-circle', href: '/contact' },
  },
  {
    show: true, image: 'hero-3',
    headline: 'Affordable Compliance.<br class="hero-br"> Faster Certification.<br class="hero-br"> <em>Smarter Investment.</em>',
    sub: 'Achieve certification through a practical, streamlined approach that reduces unnecessary cost, shortens timelines and delivers greater value from your compliance investment.',
    primary: { label: 'Get a fixed-price quote' },
    secondary: { label: 'See how we work', icon: 'ti-route', href: '/process' },
  },

  // Retired slides (before Sep 2026) — kept for reference, NOT rendered.
  // ⚠ Rewrite before re-enabling: the second says "no surprise travel charges" and the third
  // claims local consultants abroad plus Arabic/German/French support — both contradict the
  // India-based delivery model (travel is charged; English only). The client also asked for
  // the small `meta` chips to be removed.
  {
    show: false, image: 'hero-1', meta: ['ISO · SOC 2 · CMMI', 'Est. 2004'],
    headline: 'Global ISO, SOC 2 and <em>compliance advisory</em> services.',
    sub: 'We help organisations implement effective management systems, close compliance gaps and prepare for independent certification, attestation and regulatory assessments.',
    primary: { label: 'Request a fixed-price proposal' },
    secondary: { label: 'Book a 30-min call', icon: 'ti-calendar-event', href: '/contact' },
  },
  {
    show: false, image: 'hero-2', meta: ['Fixed-price proposals', '24-hour response'],
    headline: 'A clear quote in <em>24 hours</em>, never an open invoice.',
    sub: 'Tell us your scope. We send a transparent, fixed-fee proposal in your preferred currency — GBP, EUR, USD or AED. No scope creep, no surprise travel charges.',
    primary: { label: 'Request your quote' },
    secondary: { label: 'Talk to a specialist', icon: 'ti-message-circle', href: '/contact' },
  },
  {
    show: false, image: 'hero-3', meta: ['Consultants in 12 countries', 'On-site or remote'],
    headline: 'Consultants <em>near you</em>, support delivered in your time zone.',
    sub: 'Local consultants across the UK, EU, Middle East and North America. No expensive international travel charges. Multi-language support in English, Arabic, German and French.',
    primary: { label: 'Find auditors in your region', href: '/contact' },
    secondary: { label: 'Get a regional quote', icon: 'ti-world' },
  },
];
const liveSlides = heroSlides.filter((s) => s.show);
const pad2 = (n: number) => String(n).padStart(2, '0');
const heroSrcset = (img: HeroImage) => `/images/${img}-768.jpg 768w, /images/${img}-1280.jpg 1280w, /images/${img}.jpg 1920w`;

// Home industries grid IS collection-driven (the 4 industries map 1:1 to v7's cards).
const featuredIndustries = (await getCollection('industries'))
  .filter((i) => i.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const industryNum = (i: number) => `/ ${String(i + 1).padStart(2, '0')}`;

// "Trusted by" client logos — add real, PERMISSIONED client logos here (drop files in
// public/images/clients/). The strip stays hidden until at least one entry exists, so
// no placeholder/fake logos ever show. Requires written client permission before use.
const clientLogos: { name: string; logo: string }[] = [
  // { name: 'Acme Ltd', logo: '/images/clients/acme.svg' },
];

// Service node from v7's schema @graph — emitted on the home page. Names describe
// what ABS sells: consulting and readiness, not the audit or certificate (Sep 2026).
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Certification Consulting Services',
  provider: { '@id': 'https://www.abscerts.com/#organization' },
  areaServed: ['United Kingdom', 'United States', 'United Arab Emirates', 'Germany', 'Saudi Arabia'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Consulting and readiness services',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'ISO 9001 implementation & certification support' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'ISO 27001 implementation & certification support' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'ISO 14001 implementation & certification support' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'ISO 45001 implementation & certification support' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'SOC 2 readiness (Type I and Type II)' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'PCI DSS compliance support' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'CMMI appraisal readiness' } },
    ],
  },
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={`/images/${liveSlides[0].image}.jpg`} imagesrcset={heroSrcset(liveSlides[0].image)} imagesizes="100vw" fetchpriority="high">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
  </Fragment>

  <!-- HERO CAROUSEL -->
  <section class="hero" aria-label="Hero carousel">
    <div class="hero-carousel" id="heroCarousel" role="region" aria-roledescription="carousel">

      {liveSlides.map((s, i) => {
        const Heading = i === 0 ? 'h1' : 'h2';
        return (
          <article class:list={['hero-slide', { active: i === 0 }]} aria-roledescription="slide" aria-label={`Slide ${i + 1} of ${liveSlides.length}`}>
            <div class="hero-slide-img">
              <img src={`/images/${s.image}.jpg`} alt={heroImageAlt[s.image]}
                   srcset={heroSrcset(s.image)} sizes="100vw"
                   fetchpriority={i === 0 ? 'high' : undefined} loading={i === 0 ? undefined : 'lazy'} decoding="async" width="1920" height="1080">
            </div>
            <div class="hero-slide-content">
              <div class="container">
                <div class="hero-slide-inner">
                  {s.meta && s.meta.length > 0 && (
                    <div class="hero-slide-meta">
                      {s.meta.map((m) => <span class="hero-slide-meta-item">{m}</span>)}
                    </div>
                  )}
                  <Heading set:html={s.headline} />
                  <p class="hero-slide-sub">{s.sub}</p>
                  <div class="hero-slide-cta">
                    {s.primary.href
                      ? <a class="btn btn-primary" href={s.primary.href}>{s.primary.label} <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></a>
                      : <button class="btn btn-primary" onclick="openQuoteModal()">{s.primary.label} <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></button>}
                    {s.secondary.href
                      ? <a class="btn btn-outline" href={s.secondary.href}><i class={`ti ${s.secondary.icon}`}></i>{s.secondary.label}</a>
                      : <button class="btn btn-outline" onclick="openQuoteModal()"><i class={`ti ${s.secondary.icon}`}></i>{s.secondary.label}</button>}
                  </div>
                </div>
              </div>
            </div>
          </article>
        );
      })}

      <!-- Controls -->
      <div class="hero-controls">
        <div class="container">
          <div class="hero-dots" role="tablist" aria-label="Choose hero slide">
            {liveSlides.map((_, i) => (
              <button class:list={['hero-dot', { active: i === 0 }]} onclick={`goToSlide(${i})`} aria-label={`Go to slide ${i + 1}`} role="tab"></button>
            ))}
          </div>
          <div class="hero-counter" aria-live="polite">
            <strong id="heroCurrent">01</strong><span>/</span>{pad2(liveSlides.length)}
          </div>
          <div class="hero-arrows">
            <button class="hero-arrow" onclick="prevSlide()" aria-label="Previous slide"><i class="ti ti-arrow-left"></i></button>
            <button class="hero-arrow" onclick="nextSlide()" aria-label="Next slide"><i class="ti ti-arrow-right"></i></button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HERO STATS STRIP -->
  <section class="hero-stats" aria-label="Key statistics">
    <div class="container">
      <div class="hero-stats-grid">
        <div class="hero-stat">
          <div class="num">1,200<small>+</small></div>
          <div class="label">Certification &amp; compliance engagements supported</div>
        </div>
        <div class="hero-stat">
          <div class="num">500<small>+</small></div>
          <div class="label">Clients supported successfully</div>
        </div>
        <div class="hero-stat">
          <div class="num">{yearsActive}<small>yrs</small></div>
          <div class="label">In certification & advisory</div>
        </div>
        <div class="hero-stat">
          <div class="num">12<small>+</small></div>
          <div class="label">Experienced consultants</div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUSTED BY (client logos) — hidden until real, permissioned logos are added to clientLogos[] -->
  {clientLogos.length > 0 && (
    <section class="trusted-strip">
      <div class="container">
        <p class="trusted-label">Trusted by teams at</p>
        <div class="trusted-logos">
          {clientLogos.map((c) => <img src={c.logo} alt={c.name} height="34" loading="lazy" decoding="async">)}
        </div>
      </div>
    </section>
  )}

  <!-- SERVICES -->
  <section class="section section-white" id="services">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left">
          <p class="eyebrow">01 / Our services</p>
          <h2>The Right Certifications for the <em>Markets You Want to Win</em></h2>
        </div>
        <div class="section-head-right">
          <p>We provide consulting, implementation and audit-readiness support across ISO, SOC 2, CMMI and more — guiding you through to successful certification, so your customers in London, Frankfurt, Dubai or Austin can trust what's printed on your certificate.</p>
          <button class="btn btn-outline" onclick="openQuoteModal()">Talk to a specialist <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></button>
        </div>
      </div>

      <div class="services-grid">
        {homeServices.map((s) => (
          <ServiceCard
            tag={s.tag}
            num={s.num}
            image={s.image}
            imageAlt={s.imageAlt}
            title={s.title}
            description={s.description}
            tags={s.tags}
            detailHref={s.href}
          />
        ))}
      </div>

      <div class="section-cta">
        <a class="btn btn-primary" href="/services">See all services <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></a>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section section-tint" id="process">
    <div class="container">
      <div class="process-wrap">
        <div class="process-img">
          <img src="/images/home-process.jpg" alt="ABS consultant in discussion with a client team" loading="lazy" decoding="async" width="900" height="1125">
          <div class="process-img-tag">
            <i class="ti ti-route"></i>
            <span>Five clear steps to certification readiness</span>
          </div>
        </div>
        <div>
          <p class="eyebrow" style="margin-bottom:24px">02 / How we work</p>
          <h2 style="margin-bottom:24px">A clear path, from <em>first conversation</em> to certification readiness.</h2>
          <p style="font-size:16px; margin-bottom:40px; max-width:540px;">No mystery, no surprise charges. Here's exactly what working with ABS looks like, from the first conversation to your independent audit.</p>

          <div class="process-steps">
            <div class="process-step">
              <div class="process-step-num">/ 01</div>
              <div class="process-step-body">
                <h3>Discovery &amp; Scope Definition</h3>
                <p>We understand your business, customer requirements, applicable standards, certification goals and timelines to define the right compliance roadmap.</p>
              </div>
            </div>
            <div class="process-step">
              <div class="process-step-num">/ 02</div>
              <div class="process-step-body">
                <h3>Gap Assessment &amp; Roadmap</h3>
                <p>We assess your current systems, controls and documentation against the selected standard and identify priorities, gaps and required actions.</p>
              </div>
            </div>
            <div class="process-step">
              <div class="process-step-num">/ 03</div>
              <div class="process-step-body">
                <h3>Implementation &amp; Control Strengthening</h3>
                <p>Our consultants help develop and implement practical policies, processes, controls and evidence aligned with your actual business operations.</p>
              </div>
            </div>
            <div class="process-step">
              <div class="process-step-num">/ 04</div>
              <div class="process-step-body">
                <h3>Audit Readiness &amp; Pre-Assessment</h3>
                <p>We review implementation, verify evidence, conduct readiness checks and help your team prepare confidently for the independent certification or attestation audit.</p>
              </div>
            </div>
            <div class="process-step">
              <div class="process-step-num">/ 05</div>
              <div class="process-step-body">
                <h3>Independent Audit &amp; Certification Support</h3>
                <p>We coordinate and support you through the independent assessment process, help address audit findings and guide you through to successful completion.</p>
              </div>
            </div>
          </div>

          <div style="margin-top:40px; display:flex; gap:14px; flex-wrap:wrap;">
            <button class="btn btn-primary" onclick="openQuoteModal()">Start your compliance project <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></button>
            <a class="btn btn-outline" href="/process">See the full process <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="section section-white" id="industries">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left">
          <p class="eyebrow">03 / Industries</p>
          <h2>Specialised expertise across your <em>sector</em>.</h2>
        </div>
        <div class="section-head-right">
          <p>Our consultants don't just know the standards — they know your industry. From SaaS startups to global manufacturers, we bring sector context to every engagement.</p>
        </div>
      </div>

      <div class="industries-grid">
        {featuredIndustries.map((ind, i) => (
          <IndustryCard
            num={industryNum(i)}
            title={ind.data.title}
            description={ind.data.description}
            image={ind.data.image}
            imageAlt={ind.data.imageAlt}
            href={`/industries/${ind.id}`}
          />
        ))}
      </div>

      <div style="text-align:center; margin-top:48px;">
        <button class="btn btn-outline" onclick="openQuoteModal()">Don't see your industry? Talk to us <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></button>
      </div>
    </div>
  </section>

  <!-- WHY US -->
  <section class="section section-tint">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left">
          <p class="eyebrow">04 / Why ABS</p>
          <h2>Designed for buyers <em>outside India</em>.</h2>
        </div>
        <div class="section-head-right">
          <p>We've built ABS specifically to serve overseas clients. That means time-zone-friendly delivery, fixed-fee transparent pricing in your currency, and an experienced India-based team that works with you remotely — and on-site when your scope needs it.</p>
        </div>
      </div>

      <div class="why-wrap">
        <div class="why-image">
          <img src="/images/home-why-us.jpg" alt="Modern global office serving international certification clients" loading="lazy" decoding="async" width="800" height="1000">
        </div>
        <div class="why-items">
          <div class="why-item">
            <div class="why-num">/ 01</div>
            <div>
              <h3>Time-zone friendly delivery</h3>
              <p>Dedicated coordinators working across GMT, CET, EST and GST hours. You're never waiting overnight for a response.</p>
              <a href="/contact" class="why-item-link">Book a call in your time zone <i class="ti ti-arrow-right" style="font-size:12px"></i></a>
            </div>
          </div>
          <div class="why-item">
            <div class="why-num">/ 02</div>
            <div>
              <h3>Transparent fixed pricing</h3>
              <p>Fixed-fee proposals in GBP, EUR, USD or AED. No scope creep, and any on-site travel is agreed upfront — no surprises at invoice time.</p>
              <a href="#" class="why-item-link" onclick="openQuoteModal(); return false;">Request a fixed-price quote <i class="ti ti-arrow-right" style="font-size:12px"></i></a>
            </div>
          </div>
          <div class="why-item">
            <div class="why-num">/ 03</div>
            <div>
              <h3>Remote-first, on-site when needed</h3>
              <p>Most of the work — gap assessment, documentation, training and audit preparation — is delivered remotely. When your scope needs on-site work, our consultants travel to you, with travel costs agreed in your proposal.</p>
              <a href="/contact" class="why-item-link">See the regions we serve <i class="ti ti-arrow-right" style="font-size:12px"></i></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- NUMBERS STRIP (dark blue) -->
  <section class="numbers-strip">
    <div class="container">
      <div class="numbers-strip-head">
        <div>
          <p class="eyebrow">05 / By the numbers</p>
          <h2 style="margin-top:24px">Built on a foundation of <em style="color:var(--glow)">measurable trust</em>.</h2>
        </div>
        <a class="btn btn-light" href="/contact">Talk to our team <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></a>
      </div>
      <div class="numbers-grid">
        <div class="numbers-item">
          <div class="numbers-num">1,200<small>+</small></div>
          <div class="numbers-label">Certification and compliance engagements supported across the UK, EU, US, Middle East and APAC since 2004.</div>
        </div>
        <div class="numbers-item">
          <div class="numbers-num">24<small>h</small></div>
          <div class="numbers-label">Typical response time for enquiries — within one working day.</div>
        </div>
        <div class="numbers-item">
          <div class="numbers-num">11<small>wk</small></div>
          <div class="numbers-label">Typical implementation timeline to certification readiness for ISO standards.</div>
        </div>
      </div>
      <p style="margin-top:16px;font-size:12px;opacity:0.6;">Figures updated September 2026.</p>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section section-white">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left">
          <p class="eyebrow">06 / Client outcomes</p>
          <h2>What clients say after <em>working with us</em>.</h2>
        </div>
      </div>

      <div class="testimonial-feature">
        <div class="testimonial-img">
          <img src="/images/home-testimonial-steelbird.jpg" alt="SteelBird Helmets — ISO 27001 consulting client of ABS" loading="lazy" decoding="async" width="800" height="1000">
          <div class="testimonial-img-flag">🇮🇳 India</div>
        </div>
        <div>
          <span class="testimonial-quote-mark">"</span>
          <blockquote>We took certification and consulting services for ISO 27001 certification, and ABS provided us the complete solution — within budget and on time.</blockquote>
          <div class="testimonial-author">
            <div class="testimonial-author-avatar">SB</div>
            <div class="testimonial-author-info">
              <p>SteelBird Helmets</p>
              <p>Customer</p>
            </div>
          </div>
