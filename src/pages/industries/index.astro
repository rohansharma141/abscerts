---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import IndustryCard from '../../components/ui/IndustryCard.astro';
import CTABanner from '../../components/sections/CTABanner.astro';

const title = 'Industries We Serve | ISO, SOC 2 & PCI DSS | ABS';
const description =
  'Sector-specialised certification consulting for SaaS, manufacturing, healthcare and finance — consultants who know your industry, not just the standard.';
const canonical = new URL('/industries', Astro.site).href;

const industries = (await getCollection('industries')).sort((a, b) => a.data.order - b.data.order);
const num = (i: number) => `/ ${String(i + 1).padStart(2, '0')}`;
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Industries', item: canonical },
      ],
    })} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'CollectionPage',
      name: 'Industries We Serve', url: canonical,
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: industries.map((ind, i) => ({
          '@type': 'ListItem', position: i + 1, name: ind.data.shortName ?? ind.data.title,
          url: new URL(`/industries/${ind.id}`, Astro.site).href,
        })),
      },
    })} />
  </Fragment>
  <section class="page-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span>/</span> <strong>Industries</strong>
      </nav>
      <p class="eyebrow" style="margin-bottom:24px">Industries</p>
      <h1>Specialised expertise across your <em>sector</em>.</h1>
      <p style="font-size:19px; color:var(--gray-text); max-width:680px; line-height:1.6; margin-top:20px;">
        Our consultants don't just know the standards — they know your industry. From SaaS startups to global
        manufacturers, we bring sector context to every engagement.
      </p>
    </div>
  </section>

  <section class="section section-tint" style="padding:64px 0 100px;">
    <div class="container">
      <div class="industries-grid">
        {industries.map((ind, i) => (
          <IndustryCard
            num={num(i)}
            title={ind.data.title}
            description={ind.data.description}
            image={ind.data.image}
            imageAlt={ind.data.imageAlt}
            href={`/industries/${ind.id}`}
          />
        ))}
      </div>
    </div>
  </section>

  <CTABanner />
</BaseLayout>

<style>
  .crumbs {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gray-soft);
    margin-bottom: 28px;
  }
  .crumbs a { color: var(--gray-soft); transition: color 0.2s; }
  .crumbs a:hover { color: var(--blue); }
  .crumbs span { margin: 0 8px; color: var(--line-strong); }
  .crumbs strong { color: var(--blue-ink); font-weight: 500; }
</style>
