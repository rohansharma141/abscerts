---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Contact ABS Certifications | Talk to a certification specialist';
const description =
  'Get in touch with ABS Certifications & Advisory. Request a fixed-price ISO or SOC 2 quote or book a consultation in your time zone. Response within 4 business hours.';

// FAQPage node from v7's schema @graph — emitted on the contact page (where the FAQ is shown).
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How long does ISO 27001 certification typically take?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'For most organisations under 200 employees, the full path from kick-off to certificate takes 10-14 weeks. Larger or multi-site organisations typically take 4-6 months. We give you a firm timeline with your initial quote.',
      },
    },
    {
      '@type': 'Question',
      name: 'Will our certification be recognised internationally?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. We prepare you for certification against internationally recognised standards such as ISO 9001 and ISO 27001. The certificate itself is issued by an independent certification body — we help you select an appropriately accredited one and get you audit-ready, so the certificate carries weight with customers and regulators wherever you operate.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do you charge travel costs for on-site work abroad?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No surprise charges. Because our consultants are based in 12 countries, on-site work in the UK, EU, US and Middle East is typically delivered without international travel costs. Any local travel is included in your fixed-fee quote.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can you support us remotely?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Yes. Much of our work — gap analysis, documentation review, training and audit preparation — is delivered fully remotely. Where an on-site visit adds value, or where your certification body requires one, we'll agree that with you upfront.",
      },
    },
    {
      '@type': 'Question',
      name: 'What does the engagement cost?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Our consulting fees depend on the standard, organisation size, number of sites and complexity of scope, and we send a fixed-price proposal within 24 hours of your enquiry. The independent certification body charges its own separate audit, surveillance and recertification fees, which we identify clearly so the total picture is transparent.',
      },
    },
  ],
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <section class="page-hero">
    <div class="container">
      <div class="page-hero-grid">
        <div>
          <p class="eyebrow" style="margin-bottom:24px">Get in touch</p>
          <h1>Talk to a <em>certification specialist</em>.</h1>
          <p>Most enquiries receive a response within 4 business hours. For urgent matters, call the numbers below or schedule a meeting in your time zone.</p>
        </div>
        <div class="page-hero-img">
          <img src="/images/contact-team.jpg" alt="ABS meeting room set up for a client consultation" loading="lazy" decoding="async" width="800" height="600">
        </div>
      </div>
    </div>
  </section>

  <section class="section section-tint" style="padding-top:80px;">
    <div class="container">

      <div class="quick-actions-grid" style="grid-template-columns:repeat(3,1fr)">
        <div class="quick-action" onclick="openQuoteModal()">
          <div class="quick-action-icon"><i class="ti ti-file-invoice"></i></div>
          <h3>Request a quote</h3>
          <p>Fixed price within 24 hours</p>
          <span class="quick-action-link">Send enquiry <i class="ti ti-arrow-right" style="font-size:11px"></i></span>
        </div>
        <div class="quick-action">
          <div class="quick-action-icon"><i class="ti ti-calendar-event"></i></div>
          <h3>Book a meeting</h3>
          <p>30-min consultation in your time zone</p>
          <span class="quick-action-link">Pick a slot <i class="ti ti-arrow-right" style="font-size:11px"></i></span>
        </div>
        <div class="quick-action">
          <div class="quick-action-icon"><i class="ti ti-headset"></i></div>
          <h3>Existing client</h3>
          <p>Audit & support help</p>
          <span class="quick-action-link">Contact support <i class="ti ti-arrow-right" style="font-size:11px"></i></span>
        </div>
      </div>

      <div class="contact-grid" id="contact-form">

        <div class="contact-form-wrap">
          <p class="eyebrow" style="margin-bottom:20px">Enquiry form</p>
          <h2>Send us an <em>enquiry</em></h2>
          <p>We'll respond within 4 business hours. All enquiries are handled confidentially.</p>

          <form data-form="contact">
            <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp-field">
            <div class="form-row">
              <div>
                <label for="ct-name">Full name *</label>
                <input type="text" id="ct-name" name="name" class="form-control" placeholder="Jane Smith" required>
              </div>
              <div>
                <label for="ct-email">Work email *</label>
                <input type="email" id="ct-email" name="email" class="form-control" placeholder="jane@company.com" required>
              </div>
            </div>

            <div class="form-row">
              <div>
                <label for="ct-company">Company *</label>
                <input type="text" id="ct-company" name="company" class="form-control" placeholder="Acme Ltd" required>
              </div>
              <div>
                <label for="ct-country">Country *</label>
                <select id="ct-country" name="country" class="form-control" required>
                  <option value="">Select country</option>
                  <option>India</option>
                  <option>United Kingdom</option>
                  <option>United States</option>
                  <option>United Arab Emirates</option>
                  <option>Germany</option>
                  <option>Saudi Arabia</option>
                  <option>France</option>
                  <option>Netherlands</option>
                  <option>Qatar</option>
                  <option>Other</option>
                </select>
              </div>
            </div>

            <div class="form-row">
              <div>
                <label for="ct-phone">Phone (with country code)</label>
                <input type="tel" id="ct-phone" name="phone" class="form-control" placeholder="+44 20 7946 0958">
              </div>
              <div>
                <label for="ct-companySize">Company size</label>
                <select id="ct-companySize" name="companySize" class="form-control">
                  <option>1–10 employees</option>
                  <option>11–50 employees</option>
                  <option>51–200 employees</option>
                  <option>201–1000 employees</option>
                  <option>1000+ employees</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="ct-service">Service of interest *</label>
              <select id="ct-service" name="service" class="form-control" required>
                <option value="">Select a service</option>
                <option>ISO 9001 — Quality Management</option>
                <option>ISO 27001 — Information Security</option>
                <option>ISO 14001 — Environmental Management</option>
                <option>ISO 45001 — Occupational Health & Safety</option>
                <option>SOC 2 Type I / II</option>
                <option>PCI DSS</option>
                <option>CMMI appraisal</option>
                <option>Cyber security / VAPT</option>
                <option>Other / not sure yet</option>
              </select>
            </div>

            <div class="form-group">
              <label for="ct-message">Tell us about your project</label>
              <textarea id="ct-message" name="message" class="form-control" placeholder="Brief on scope, target date, any existing certifications, number of sites, etc."></textarea>
            </div>

            <div class="checkbox-row">
              <input type="checkbox" id="agree" name="agree" required>
              <label for="agree" style="margin:0;color:var(--gray-text);font-family:inherit;text-transform:none;letter-spacing:0">I agree to ABS's privacy policy. We never share your details with third parties.</label>
            </div>

            <button type="submit" class="form-submit" data-submit>Send enquiry <i class="ti ti-arrow-right"></i></button>
            <div data-form-status></div>
          </form>
        </div>

        <div class="contact-sidebar">

          <div class="contact-card">
            <div class="contact-card-head">
              <div class="contact-card-icon"><i class="ti ti-phone"></i></div>
              <h3>Call us directly</h3>
            </div>
            <div class="phone-item">
              <div class="phone-flag">🇮🇳</div>
              <div>
                <a href="tel:+919625776771" class="phone-num">+91 96257 76771</a>
                <span class="phone-meta">Sales · new enquiries</span>
              </div>
            </div>
            <div class="phone-item">
              <div class="phone-flag">🇮🇳</div>
              <div>
                <a href="tel:+919792586202" class="phone-num">+91 97925 86202</a>
                <span class="phone-meta">Audits · existing clients</span>
              </div>
            </div>
            <div class="hours-box">
              <div class="hours-box-head"><i class="ti ti-clock"></i>Mon–Fri · 9:00–18:00 IST</div>
              <span class="tz">3:30–12:30 GMT &nbsp;·&nbsp; 6:30–15:30 GST &nbsp;·&nbsp; 23:30–08:30 EST (prev day)</span>
            </div>
          </div>

          <div class="contact-card">
            <div class="contact-card-head">
              <div class="contact-card-icon"><i class="ti ti-mail"></i></div>
              <h3>Email us</h3>
            </div>
            <div class="email-item">
              <i class="ti ti-mail"></i>
              <a href="mailto:info@abscerts.com">info@abscerts.com</a>
              <span class="email-item-meta">General</span>
            </div>
            <div class="email-item">
              <i class="ti ti-mail"></i>
              <a href="mailto:sales@abscerts.com">sales@abscerts.com</a>
              <span class="email-item-meta">Sales</span>
            </div>
            <div class="email-item">
              <i class="ti ti-mail"></i>
              <a href="mailto:audits@abscerts.com">audits@abscerts.com</a>
              <span class="email-item-meta">Audits</span>
            </div>
          </div>

          <div class="contact-card">
            <div class="contact-card-head">
              <div class="contact-card-icon"><i class="ti ti-map-pin"></i></div>
              <h3>Head office</h3>
            </div>
            <iframe
              class="map-embed"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1824.231487910349!2d80.14789223870258!3d27.395190925502554!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x399ef9d1436f963d%3A0x89022124d4017873!2sMangli%20Purwa%2C%20Saiyapurwa%2C%20Hardoi%2C%20Uttar%20Pradesh%20241001!5e1!3m2!1sen!2sin!4v1783789836347!5m2!1sen!2sin"
              title="ABS Certifications & Advisory office location on Google Maps — Mangli Purwa, Hardoi, Uttar Pradesh"
              allowfullscreen
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"></iframe>
            <p class="address-text">
              Building No. 1, C/O Sriram, Near Railway Phatak,<br>
              Mangli Purwa, Hardoi Gramin, District Hardoi,<br>
              Uttar Pradesh — 241001, India
            </p>
            <a href="https://www.google.com/maps/search/?api=1&query=Mangli%20Purwa%2C%20Saiyapurwa%2C%20Hardoi%2C%20Uttar%20Pradesh%20241001" target="_blank" rel="noopener" class="btn btn-outline-blue" style="width:100%; justify-content:center; padding:12px 22px; font-size:13px;">View on Google Maps <i class="ti ti-external-link" style="font-size:14px"></i></a>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Regional reach -->
  <section class="section section-white">
    <div class="container">
      <div class="section-head">
        <div class="section-head-left">
          <p class="eyebrow">Regional reach</p>
          <h2>Audit partners across <em>your region</em>.</h2>
        </div>
        <div class="section-head-right">
          <p>We don't fly consultants halfway around the world to charge you for it. Our consultants are based in 12 countries, ready to work in your time zone, your language, your currency.</p>
        </div>
      </div>

      <div class="regions-grid">
        <div class="region-card">
          <div class="region-img">
            <img src="/images/region-uk.jpg" alt="London — UK certification consulting and audit readiness" loading="lazy" decoding="async" width="600" height="375">
          </div>
          <div class="region-body">
            <span class="region-flag">🇬🇧</span>
            <h3>United Kingdom</h3>
            <p>Consultants in London & Manchester. GBP invoicing.</p>
            <a href="#contact-form" class="region-cta">Talk to UK team <i class="ti ti-arrow-right" style="font-size:11px"></i></a>
          </div>
        </div>
        <div class="region-card">
          <div class="region-img">
            <img src="/images/region-europe.jpg" alt="European cities — ISO certification across DE, FR, NL, ES, PL" loading="lazy" decoding="async" width="600" height="375">
          </div>
          <div class="region-body">
            <span class="region-flag">🇪🇺</span>
            <h3>Europe</h3>
            <p>Consultants across DE, FR, NL, ES, PL. EUR invoicing. Multi-language support.</p>
            <a href="#contact-form" class="region-cta">Talk to EU team <i class="ti ti-arrow-right" style="font-size:11px"></i></a>
          </div>
        </div>
        <div class="region-card">
          <div class="region-img">
            <img src="/images/region-middle-east.jpg" alt="Dubai skyline — Middle East ISO certification UAE, KSA, Qatar, Oman" loading="lazy" decoding="async" width="600" height="375">
          </div>
          <div class="region-body">
            <span class="region-flag">🇦🇪</span>
            <h3>Middle East</h3>
            <p>Coverage in UAE, KSA, Qatar, Oman. AED & USD invoicing. Arabic-speaking consultants.</p>
            <a href="#contact-form" class="region-cta">Talk to ME team <i class="ti ti-arrow-right" style="font-size:11px"></i></a>
          </div>
        </div>
        <div class="region-card">
          <div class="region-img">
            <img src="/images/region-north-america.jpg" alt="New York skyline — North America SOC 2 and PCI DSS certification" loading="lazy" decoding="async" width="600" height="375">
          </div>
          <div class="region-body">
            <span class="region-flag">🇺🇸</span>
            <h3>North America</h3>
            <p>SOC 2 and PCI DSS specialists in US & Canada. USD invoicing. AICPA-aligned.</p>
            <a href="#contact-form" class="region-cta">Talk to US team <i class="ti ti-arrow-right" style="font-size:11px"></i></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section-tint">
    <div class="container">
      <div class="faq-grid">
        <div class="faq-side">
          <p class="eyebrow" style="margin-bottom:24px">FAQ</p>
          <h2>Common <em>questions</em> before reaching out.</h2>
          <p>Don't see your question here? Our team is one click away — and we promise human answers, not chatbot fluff.</p>
          <button class="btn btn-primary" onclick="document.getElementById('contact-form').scrollIntoView({behavior:'smooth'})">Ask us anything <span class="btn-icon-square"><i class="ti ti-arrow-up-right"></i></span></button>
        </div>
        <div class="faq-list">
          <div class="faq-item open">
            <button class="faq-q" onclick="toggleFaq(this)">How long does ISO 27001 certification typically take?<span class="icon"><i class="ti ti-plus"></i></span></button>
            <div class="faq-a">For most organisations under 200 employees, the full path from kick-off to certificate takes 10–14 weeks. Larger or multi-site organisations typically take 4–6 months. We give you a firm timeline with your initial quote.</div>
          </div>
          <div class="faq-item">
            <button class="faq-q" onclick="toggleFaq(this)">Will our certification be recognised internationally?<span class="icon"><i class="ti ti-plus"></i></span></button>
            <div class="faq-a">Yes. We prepare you for certification against internationally recognised standards such as ISO 9001 and ISO 27001. The certificate itself is issued by an independent certification body — we help you select an appropriately accredited one and get you audit-ready, so the certificate carries weight with customers and regulators wherever you operate.</div>
          </div>
          <div class="faq-item">
            <button class="faq-q" onclick="toggleFaq(this)">Do you charge travel costs for on-site work abroad?<span class="icon"><i class="ti ti-plus"></i></span></button>
            <div class="faq-a">No surprise charges. Because our consultants are based in 12 countries, on-site work in the UK, EU, US and Middle East is typically delivered without international travel costs. Any local travel is included in your fixed-fee quote.</div>
          </div>
          <div class="faq-item">
            <button class="faq-q" onclick="toggleFaq(this)">Can you support us remotely?<span class="icon"><i class="ti ti-plus"></i></span></button>
            <div class="faq-a">Yes. Much of our work — gap analysis, documentation review, training and audit preparation — is delivered fully remotely. Where an on-site visit adds value, or where your certification body requires one, we'll agree that with you upfront.</div>
          </div>
          <div class="faq-item">
            <button class="faq-q" onclick="toggleFaq(this)">What does the engagement cost?<span class="icon"><i class="ti ti-plus"></i></span></button>
            <div class="faq-a">Our consulting fees depend on the standard, organisation size, number of sites and complexity of scope, and we send a fixed-price proposal within 24 hours of your enquiry. The independent certification body charges its own separate audit, surveillance and recertification fees, which we identify clearly so the total picture is transparent.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA on contact page -->
  <section class="cta-banner">
    <div class="cta-banner-bg"></div>
    <div class="cta-banner-overlay"></div>
    <div class="container">
      <p class="eyebrow">Still deciding?</p>
      <h2>Not sure where to <em>start</em>?</h2>
      <p>Book a free 30-minute consultation. We'll review your goals, recommend the right standard, and outline a realistic timeline — no obligation.</p>
      <div class="cta-buttons">
        <button class="btn btn-glow"><i class="ti ti-calendar-event"></i>Book free consultation</button>
        <button class="btn btn-outline" onclick="document.getElementById('contact-form').scrollIntoView({behavior:'smooth'})">Send a written enquiry instead</button>
      </div>
    </div>
  </section>
</BaseLayout>
