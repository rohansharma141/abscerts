---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/sections/CTABanner.astro';

export async function getStaticPaths() {
  const studies = (await getCollection('caseStudies')).filter((c) => !c.data.draft);
  return studies.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const canonical = new URL(`/case-studies/${entry.id}`, Astro.site).href;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Case studies', item: new URL('/case-studies', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: d.title, item: canonical },
  ],
};
---

<BaseLayout title={`${d.title} | ABS Certifications`} description={d.summary} canonical={canonical} ogImage={d.image}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <section class="cat-hero">
    <div class="container narrow">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span>/</span> <a href="/case-studies">Case studies</a> <span>/</span> <strong>{d.client}</strong>
      </nav>
      <div class="service-tags" style="margin-bottom:16px;">
        {d.standards.map((s) => <span class="service-tag">{s}</span>)}
      </div>
      <h1>{d.title}</h1>
      <p class="cat-hero-sub">{d.client} · {d.industry}</p>
    </div>
  </section>

  <section class="section section-white" style="padding:40px 0 0;">
    <div class="container narrow">
      <div class="blog-post-cover" style="overflow:hidden;border:1px solid var(--line-strong);aspect-ratio:2/1;">
        <img src={d.image} alt={d.imageAlt} loading="eager" decoding="async" width="1200" height="600" style="width:100%;height:100%;object-fit:cover;">
      </div>
    </div>
  </section>

  <section class="section section-white" style="padding:48px 0 72px;">
    <div class="container narrow">
      <article class="prose"><Content /></article>
    </div>
  </section>

  <CTABanner />
</BaseLayout>
