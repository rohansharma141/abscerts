---
import { getCollection } from 'astro:content';

// Desktop mega-menu (≥1080px). 5×2 grid, one category per cell, positioned by the
// category's column/row frontmatter. Each cell: clickable category heading → category
// landing page, top 4 services (by order) → service pages, and a "View all N →" link.
const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const allServices = await getCollection('services');

const cells = categories.map((cat) => {
  const services = allServices
    .filter((s) => s.data.category === cat.id)
    .sort((a, b) => a.data.order - b.data.order);
  return {
    slug: cat.id,
    shortName: cat.data.shortName,
    column: cat.data.column,
    row: cat.data.row,
    topServices: services.slice(0, 4),
    count: services.length,
  };
});
---

<!-- A navigation landmark of plain links (content review, N15): ARIA menu roles don't fit site navigation
     and failed Lighthouse's aria-required-children / aria-required-parent checks. -->
<nav class="mega-menu" id="megaMenu" aria-label="Services categories">
  <div class="mega-menu-grid">
    {cells.map((cell) => (
      <div class="mega-cell" style={`grid-column:${cell.column};grid-row:${cell.row};`}>
        <a href={`/services/${cell.slug}`} class="mega-cell-head">{cell.shortName}</a>
        {cell.topServices.length > 0 && (
          <ul class="mega-cell-list">
            {cell.topServices.map((s) => (
              <li><a href={`/services/${s.id}`}>{s.data.shortName}</a></li>
            ))}
          </ul>
        )}
        <a href={`/services/${cell.slug}`} class="mega-cell-all">
          View all{cell.count > 0 ? ` ${cell.count}` : ''} <i class="ti ti-arrow-right"></i>
        </a>
      </div>
    ))}
  </div>
</nav>
