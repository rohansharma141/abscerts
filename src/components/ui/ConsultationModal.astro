---
// "Book a consultation" pop-up, posting to /api/consultation (content review, decision §8.2). Opened with
// openConsultModal() from public/scripts/global.js; one per page (id="consultModal").
//
// variant "full" (contact page): the original form, with country, service area and preferred times.
// variant "basic" (QBIX page, Nov 2026): basic details only, no drop-downs (Rohan, 18 Nov 2026). The service
// is sent as a hidden field so ABS can see what the request is about; country is optional in the API.
interface Props {
  variant?: 'full' | 'basic';
  eyebrow?: string;
  eyebrowBold?: boolean;        // QBIX page: its label is bold (Rohan, 18 Nov 2026)
  title?: string;
  intro?: string;
  service?: string;             // basic variant: the hidden `service` value
  messagePlaceholder?: string;
}
const {
  variant = 'full',
  eyebrow = 'Free · No obligation',
  eyebrowBold = false,
  title = 'Book a free consultation',
  intro = "Tell us what you'd like to discuss and when suits you, and we'll be in touch to arrange a time.",
  service = '',
  messagePlaceholder = "Optional — your goals, the standard you're considering, or any questions.",
} = Astro.props;
---

<div class="modal-backdrop" id="consultModal" inert onclick="if(event.target===this) closeConsultModal()">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="consultModalTitle" tabindex="-1">
    <div class="modal-header">
      <button class="modal-close" onclick="closeConsultModal()" aria-label="Close"><i class="ti ti-x"></i></button>
      <p class="eyebrow" style={eyebrowBold ? 'font-weight:700' : undefined}>{eyebrow}</p>
      <h2 id="consultModalTitle">{title}</h2>
      <p>{intro}</p>
    </div>
    <div class="modal-body">
      <form data-form="consultation">
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp-field">
        {variant === 'basic' && <input type="hidden" name="service" value={service}>}
        <div class="form-row">
          <div>
            <label for="cm-name">Full name *</label>
            <input type="text" id="cm-name" name="name" class="form-control" placeholder="Jane Smith" autocomplete="name" required>
          </div>
          <div>
            <label for="cm-email">Work email *</label>
            <input type="email" id="cm-email" name="email" class="form-control" placeholder="jane@company.com" autocomplete="email" required>
          </div>
        </div>
        <div class="form-row">
          <div>
            <label for="cm-phone">Phone (with country code) *</label>
            <input type="tel" id="cm-phone" name="phone" class="form-control" placeholder="+44 20 7946 0958" autocomplete="tel" required>
          </div>
          <div>
            <label for="cm-company">Company name</label>
            <input type="text" id="cm-company" name="company" class="form-control" placeholder="Optional" autocomplete="organization">
          </div>
        </div>
        {variant === 'full' && (
          <div class="form-row">
            <div>
              <label for="cm-country">Country *</label>
              <select id="cm-country" name="country" class="form-control" required>
                <option value="">Select country</option>
                <option>India</option>
                <option>United Kingdom</option>
                <option>United States</option>
                <option>United Arab Emirates</option>
                <option>Germany</option>
                <option>Saudi Arabia</option>
                <option>France</option>
                <option>Netherlands</option>
                <option>Qatar</option>
                <option>Other</option>
              </select>
            </div>
            <div>
              <label for="cm-service">Service area *</label>
              <select id="cm-service" name="service" class="form-control" required>
                <option value="">Select a service area</option>
                <option>Cyber Security</option>
                <option>ISO Certifications</option>
                <option>CMMI &amp; Process</option>
                <option>Food, Automotive & Manufacturing</option>
                <option>Training &amp; Professional Development</option>
                <option>Data Analytics</option>
                <option>Agile Transformation</option>
                <option>Third Party Inspection</option>
                <option>HR Services</option>
                <option>Other</option>
              </select>
            </div>
          </div>
        )}
        <div class="form-group">
          <label for="cm-message">What would you like to discuss?</label>
          <textarea id="cm-message" name="message" class="form-control" placeholder={messagePlaceholder}></textarea>
        </div>
        {variant === 'full' && (
          <div class="form-group">
            <label for="cm-times">Preferred days and times</label>
            <input type="text" id="cm-times" name="preferredTimes" class="form-control" placeholder="e.g. Tuesday or Wednesday afternoon">
          </div>
        )}
        <button type="submit" class="form-submit" data-submit>Send request <i class="ti ti-arrow-right"></i></button>
        <div data-form-status></div>
        <p class="modal-privacy">We use your details only to respond to your enquiry — see our <a href="/privacy">Privacy Policy</a>.</p>
      </form>
    </div>
  </div>
</div>
