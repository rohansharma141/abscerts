# ABS Certifications — environment variables
# Copy to .env for local dev. In production, set these in
# Cloudflare dashboard → Pages → Settings → Environment variables.
# (Phase 3 — forms/email. Not used yet in Phase 1.)

# Resend — transactional email for form submissions
RESEND_API_KEY=

# Where form submissions are delivered (e.g. sales@abscerts.com)
NOTIFICATION_EMAIL=

# Sender address — must be on a verified Resend domain (e.g. no-reply@mail.abscerts.com)
FROM_EMAIL=

# Cloudflare KV binding for certificate verification is configured in the
# Cloudflare dashboard (Workers → KV → bind as CERTIFICATES), not here. (Phase 4)
