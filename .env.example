# ABS Certifications — environment variables
# For local Pages Functions testing, copy these into a gitignored `.dev.vars`
# file at the project root (used by `npm run preview` / wrangler).
# In production, set them in the Cloudflare dashboard →
# Pages → Settings → Environment variables.

# Resend — transactional email for form submissions
RESEND_API_KEY=

# Where quote + contact form submissions are delivered (e.g. sales@abscerts.com)
NOTIFICATION_EMAIL=

# Where exit-popup newsletter leads are delivered (e.g. marketing@abscerts.com)
MARKETING_EMAIL=

# Sender address — must be on a verified Resend domain (e.g. noreply@mail.abscerts.com)
FROM_EMAIL=

# Cloudflare KV binding for certificate verification (CERTIFICATES) is configured
# via wrangler.toml locally and the Cloudflare dashboard in production. (Phase 4)
